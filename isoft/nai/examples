        /* 读写事件 */
        break;

    case NAI_IO_ERROR:
        /* 连接错误 */
        error = nai_ev_error_code(events);
        break;

    case NAI_IO_READ|NAI_IO_TIMEOUT:
        /* 读超时 */
        break;

    case NAI_IO_WRITE|NAI_IO_TIMEOUT:
        /* 写超时 */
        break;

    case NAI_IO_TIMEOUT:
        /* 用户自定义定时器 */
        break;

    caee NAI_IO_NOTIFY:
        /* 用户自定义事件 */ 
        notify_id = nai_ev_notify_code(events);
        switch (notify_id) {
        case 0:
        case 1:
        case 2:
            break;
        };
        break;
    };
};


4. 读写操作


int handle_readwrite(nai_stream_t* s)
{
    intptr_t r;
    int ec;
    int bytes;
    char* buf;
    size_t buflen;


    /* other versions: nai_stream_readv|readq */
    r = nai_stream_read(s, buf, buflen);
    if (r < 0) {
        ec = nai_errno;
        if (ec == NAI_AGAIN || ec == NAI_INPROCESS) {
            /* 操作阻塞或未完成 */
            /* 当操作处于未完成时，不可释放传入的缓冲区，直到下次读取成功 */
            goto _wait;
        };

        /* 其它错误 */
        goto _fail;
    };

    /* 数据处理 */
    bytes = r;
    /* ... */


    /* other versions: nai_stream_writev|writeq */
    r = nai_stream_write(s, buf, buflen);
    if (r < 0) {
        ec = nai_errno;
        if (ec == NAI_AGAIN || ec == NAI_INPROCESS) {
            /* 操作阻塞或未完成 */
            /* 当操作处于未完成时，不可释放传入的缓冲区，直到下次写入成功 */
            r = 0;
            goto _wait;
        };

        /* 其它错误 */
        goto _fail;
    };

    /* 结果处理 */
    bytes = r;
    /* ... */

_wait:
    return 0;

_fail:
    nai_stream_close(s);
    return -1;
};


5. 文件或管道


int start_file(nai_fd_t fd, nai_evloop_t* l)
{
    int r;
    nai_stream_t* c;


    c = (nai_stream_t*)nai_malloc(sizeof(*c));
    if (c == 0) {
        r = -1;
        goto _end;
    };

    /* 注意，非阻塞和异步文件在linux下不支持 */
    nai_stream_init(c);
    nai_stream_set_cb(c, handle_client);
    nai_stream_set_fd(c, fd, NAI_IO_FILE); /* or NAI_IO_PIPE */
    nai_stream_set_fdown(c, 1); /* stream will close fd on stream close */
    r = nai_stream_open(c, l);
    if (r < 0) {
        goto _end;
    };

_end:
    if (r < 0) {
        if (c != 0) {
            nai_stream_close(c);
            nai_free(c);
        };
    };
    return r;
};


