int handle_accept(nai_listen_t* s, int event)
{
    int r;
    nai_fd_t f;
    nai_stream_t* c = 0;


    f = nai_listen_accept(s, 0, 0);
    if (f == NAI_FD_INVALID) {
        r = -1;
        goto _end;
    };

    c = (nai_stream_t*)nai_malloc(sizeof(*c));
    if (c == 0) {
        r = -1;
        goto _end;
    };

    nai_stream_init(c);
    nai_stream_set_cb(c, handle_client);
    nai_stream_set_fd(c, fd, NAI_IO_SOCK);
    nai_stream_set_fdown(c, 1); /* stream will close fd on stream close */
    nai_stream_set_opt(c, NAI_IO_RECVTIMEO, 30*1000);
    nai_stream_set_opt(c, NAI_IO_SENDTIMEO, 30*1000);
    nai_stream_inherit(c, s);   /* inherit properties from listen */
    r = nai_stream_open(c, nai_listen_get_loop(s));
    if (r < 0) {
        goto _end;
    };

_end:
    if (r < 0) {
        if (c != 0) {
            nai_stream_close(c);
            nai_free(c);
        };
    };
    return r;
};

int start_listen(nai_evloop_t* l)
{
    int r;
    nai_listen_t* s;
    nai_socknbuf_in_t nbuf;

    nbuf.len = sizeof(nbuf.storage);
    r = nai_sockaddr_pton("127.0.0.1:5000", -1, &nbuf.addr, &nbuf.len);
    if (r < 0) {
        goto _end;
    };

    s = (nai_listen_t*)nai_malloc(sizeof(*s));
    if (s == 0) {
        r = -1;
        goto _end;
    };

    nai_listen_init(s);
    nai_listen_set_backlog(s, 100);
    nai_listen_set_cb(s, handle_accept);
    r = nai_listen_bind(s, l, &nbuf.addr, nbuf.len);
    if (r < 0) {
        goto _end;
    };

_end:
    if (r < 0) {
        if (s != 0) {
            nai_listen_close(s);
            nai_free(s);
        };
    };
    return r;
};


