演示异步事件循环创建和流操作


1. 启动事件循环


int event_loop(void* p)
{
    int r;
    nai_evloop_t* l;

    l = (nai_evloop_t*)p;
    r = nai_evloop_dispatch(l);
    return r;
};

int main()
{
    int r;
    nai_task_t task;
    nai_evloop_t* l;


    nai_task_init(&task, 0);

    /* create a new event loop */
    l = nai_evloop_new();
    if (l == 0) {
        r = -1;
        goto _fail;
    };

    /* open event loop, choose the right backend by the system */
    r = nai_evloop_open(l, 0, 0, 0);
    if (r < 0) {
        goto _end;
    };

    /* start one thread with default thread attr */
    r = nai_task_open(&task, 1, 0);
    if (r < 0) {
        goto _end;
    };

    /* start event loop */
    r = nai_task_queue(&task, event_loop, l, 0);
    if (r < 0) {
        goto _end;
    };

    /* todo something */
    /* ie, wait signal from other process */


    /* break event loop */
    r = nai_evloop_break(l, 0);
    if (r < 0) {
        goto _end;
    };

    /* wait event loop exit */
    r = nai_task_wait(&task);
    if (r < 0) {
        goto _end;
    };


_end:
    nai_task_close(&task);
    if (l != 0) {
        nai_evloop_close(l);
    };
    return r;
};


