/* The size of 'double', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_DOUBLE @NAI_SIZEOF_DOUBLE@

/* The size of 'float', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_FLOAT @NAI_SIZEOF_FLOAT@

/* The size of 'int', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_INT @NAI_SIZEOF_INT@

/* The size of 'long', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_LONG @NAI_SIZEOF_LONG@

/* The size of 'long long', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_LONG_LONG @NAI_SIZEOF_LONG_LONG@

/* The size of 'ptrdiff_t', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_PTRDIFF_T @NAI_SIZEOF_PTRDIFF_T@

/* The size of 'size_t', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_SIZE_T @NAI_SIZEOF_SIZE_T@

/* The size of 'unsigned int', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_UNSIGNED_INT @NAI_SIZEOF_UNSIGNED_INT@

/* The size of 'unsigned long', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_UNSIGNED_LONG @NAI_SIZEOF_UNSIGNED_LONG@

/* The size of 'unsigned long long', as computed by sizeof. */
#cmakedefine NAI_SIZEOF_UNSIGNED_LONG_LONG @NAI_SIZEOF_UNSIGNED_LONG_LONG@

/* The size of 'void *', as computed by sizeof. */
#define NAI_SIZEOF_VOID_P @CMAKE_SIZEOF_VOID_P@





