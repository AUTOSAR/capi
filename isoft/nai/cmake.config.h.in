/* Define to 1 if you on darwin. */
#cmakedefine __darwin__ 1

/* Define to 1 if you on freebsd. */
#cmakedefine __freebsd__ 1

/* Define to 1 if you on linux. */
#cmakedefine __linux__ 1

/* Define to 1 if you on solaris. */
#cmakedefine __solaris__ 1

/* Define to 1 if you on windows. */
#cmakedefine __windows__ 1

/* Define to 1 if you on android. */
#cmakedefine __android__ 1

/* Define to 1 if you on qnx. */
#cmakedefine __qnx__ 1

/* Define to 1 if you on sylixos. */
#cmakedefine __sylixos__ 1



/* Defined if require this standard */
#cmakedefine _GNU_SOURCE @_GNU_SOURCE@

/* Defined if require this standard */
#cmakedefine _BSD_SOURCE @_BSD_SOURCE@

/* Defined if require this standard */
#cmakedefine _QNX_SOURCE @_QNX_SOURCE@

/* Defined if require this standard */
#cmakedefine _POSIX_SOURCE @_POSIX_SOURCE@

/* Defined if require this standard */
#cmakedefine _POSIX_C_SOURCE @_POSIX_C_SOURCE@

/* Defined if require this standard */
#cmakedefine _DARWIN_C_SOURCE @_DARWIN_C_SOURCE@

/* Defined if require this standard */
#cmakedefine _DEFAULT_SOURCE @_DEFAULT_SOURCE@

/* Defined if require this standard */
#cmakedefine _LARGEFILE64_SOURCE @_LARGEFILE64_SOURCE@

/* Defined if require this standard */
#cmakedefine _XOPEN_SOURCE @_XOPEN_SOURCE@

/* Defined if require this standard */
#cmakedefine __BSD_VISIBLE @__BSD_VISIBLE@



/* Define to 1 if you required 'http'. */
#cmakedefine NAI_WITH_HTTP 1



/* Define to 1 if you have this standard */
#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 199901L
#define NAI_HAVE_C99            1
#endif


/* Define to 1 if you have the 'm' library (-lm). */
#cmakedefine NAI_HAVE_LIBM 1

/* Define if we have a threads library. */
#cmakedefine NAI_HAVE_THREADS 1

/* Define if we have the openssl. */
#cmakedefine NAI_HAVE_OPENSSL 1

/* Define if we have the wolfssl. */
#cmakedefine NAI_HAVE_WOLFSSL 1

/* Define if we have the libressl. */
#cmakedefine NAI_HAVE_LIBRESSL 1

/* Define if we have the pcre. */
#cmakedefine NAI_HAVE_PCRE 1

/* Define if we have the pcre2. */
#cmakedefine NAI_HAVE_PCRE2 1

/* Define if we have the gcc atomic. */
#cmakedefine NAI_HAVE_GCC_ATOMIC 1

/* Define if we have the atomic_ops. */
#cmakedefine NAI_HAVE_ATOMIC_OPS 1



/* Define to 1 to make mprotect behavior compatible with posix on win32 */
#cmakedefine NAI_COMPAT_POSIX_MPROTECT 1



