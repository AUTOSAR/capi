                            <GLOBAL-TIME-CORRECTION-PROPS>
                                <OFFSET-CORRECTION-ADAPTION-INTERVAL>10.0</OFFSET-CORRECTION-ADAPTION-INTERVAL>
                                <OFFSET-CORRECTION-JUMP-THRESHOLD>30.0</OFFSET-CORRECTION-JUMP-THRESHOLD>
                                <RATE-CORRECTION-MEASUREMENT-DURATION>1.0</RATE-CORRECTION-MEASUREMENT-DURATION>
                                <RATE-CORRECTIONS-PER-MEASUREMENT-DURATION>10</RATE-CORRECTIONS-PER-MEASUREMENT-DURATION>
                            </GLOBAL-TIME-CORRECTION-PROPS>
              <GLOBAL-TIME-DOMAIN-PROPERTYS>
