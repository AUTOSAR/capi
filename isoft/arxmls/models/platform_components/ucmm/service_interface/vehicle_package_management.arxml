<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ara</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>ucm</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>pkgmgr</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>portinterfaces</SHORT-NAME>
                  <ELEMENTS>
                    <SERVICE-INTERFACE>
                      <SHORT-NAME>VehiclePackageManagement</SHORT-NAME>
                      <IS-SERVICE>true</IS-SERVICE>
                      <NAMESPACES>
                        <SYMBOL-PROPS>
                          <SHORT-NAME>ara</SHORT-NAME>
                          <SYMBOL>ara</SYMBOL>
                        </SYMBOL-PROPS>
                        <SYMBOL-PROPS>
                          <SHORT-NAME>ucm</SHORT-NAME>
                          <SYMBOL>ucm</SYMBOL>
                        </SYMBOL-PROPS>
                        <SYMBOL-PROPS>
                          <SHORT-NAME>pkgmgr</SHORT-NAME>
                          <SYMBOL>pkgmgr</SYMBOL>
                        </SYMBOL-PROPS>
                      </NAMESPACES>
                      <FIELDS>
                        <FIELD>
                          <SHORT-NAME>TransferState</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">The current status of Campaign from an OTA Client perspective.</L-2>
                          </DESC>
                          <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/TransferStateType</TYPE-TREF>
                          <HAS-GETTER>true</HAS-GETTER>
                          <HAS-NOTIFIER>true</HAS-NOTIFIER>
                          <HAS-SETTER>false</HAS-SETTER>
                        </FIELD>
                        <FIELD>
                          <SHORT-NAME>RequestedPackage</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Software Package to be transfered to UCM Master</L-2>
                          </DESC>
                          <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/SwNameVersionType</TYPE-TREF>
                          <HAS-GETTER>true</HAS-GETTER>
                          <HAS-NOTIFIER>true</HAS-NOTIFIER>
                          <HAS-SETTER>false</HAS-SETTER>
                        </FIELD>
                        <FIELD>
                          <SHORT-NAME>SafetyState</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Vehicle state computed by the Vehicle State Manager Adaptive Application.</L-2>
                          </DESC>
                          <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/bool</TYPE-TREF>
                          <HAS-GETTER>true</HAS-GETTER>
                          <HAS-NOTIFIER>true</HAS-NOTIFIER>
                          <HAS-SETTER>false</HAS-SETTER>
                        </FIELD>
                      </FIELDS>

                      <METHODS>
                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>CancelCampaign</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This method aborts an ongoing campaign processing of a Vehicle Package. </L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>DisableCampaign</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">To forbid new campaign</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/bool</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/CancelFailed</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>AllowCampaign</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">To allow a new campaign to start</L-2>
                          </DESC>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>DeleteTransfer</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Delete a transferred Software or Vehicle Package.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>id</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Transfer ID of the currently running request.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/TransferIdType</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>GetCampaignHistory</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Getter method to retrieve all actions that have been performed by UCM Master.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>timestampGE</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Earliest timestamp (inclusive)</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>timestampLT</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Latest timestamp (exclusive)</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>CampaignHistory</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">The history of all actions that have been performed by UCM Master.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/CampaignHistoryVectorType</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>GetSwClusterInfo</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This method returns a list of SoftwareClusters that are in state kPresent.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>SwInfo</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">List of installed SoftwareClusters that are in state kPresent.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/SwClusterInfoVectorType</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>GetSwPackages</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">This method returns the Software Packages that are part of current campaign handled by UCM Master.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>Packages</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">List of Software Packages.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/SwPackageInfoVectorType</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>SwPackageInventory</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN"></L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>AvailableSoftwarePackages</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">List of available Software Packages in Backend corresponding to VIN.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/SwNameVersionVectorType</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>RequiredSoftwarePackages</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">List of Software Packages to be sent to UCM Master.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/SwNameVersionVectorType</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>TransferData</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Block-wise transfer of a Software or Vehicle Package to UCM Master.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>id</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Transfer ID.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/TransferIdType</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>data</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Data block of the Software or Vehicle Package.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/ByteVectorType</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>blockCounter</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Block counter value of the current block.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/IncorrectBlock</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/IncorrectBlockSize</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/BlockInconsistent</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/IncorrectSize</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/TransferInterrupted</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>TransferExit</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Finish the transfer of a Software or Vehicle Package to UCM Master.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>id</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Transfer ID of the currently running request.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/TransferIdType</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/AuthenticationFailed</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/IncompatiblePackageVersion</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InsufficientData</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InvalidPackageManifest</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InvalidTransferId</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/MissingDependencies</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OldVersion</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/PackageInconsistent</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>TransferStart</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Start the transfer of a Software Package. The name of the Software Package to be transferred to UCM</L-2>
                            <L-2 L="EN">Master must be provided. UCM Master will generate a T ransfer ID for subsequent calls to T ransferData,</L-2>
                            <L-2 L="EN">TransferExit, DeleteT ransfer. Size of Software Package to be used to transfer to UCM subordinate is</L-2>
                            <L-2 L="EN">available in the Vehicle Package and its contained Software Package Manifests.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>SoftwarePackageName</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Software Package Short Name of the Software Package to be transferred.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/SwNameType</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>id</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Return TransferId.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/TransferIdType</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>BlockSize</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Size of the blocks to be received with TransferData method.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/UnexpectedPackage</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InsufficientComputationPower</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                        <!--  operate  -->
                        <CLIENT-SERVER-OPERATION>
                          <SHORT-NAME>TransferVehiclePackage</SHORT-NAME>
                          <DESC>
                            <L-2 L="EN">Start the transfer of a Vehicle Package. The size of the Vehicle Package to be transferred to UCM Master</L-2>
                            <L-2 L="EN">must be provided. UCM Master will generate a Transfer ID for subsequent calls to TransferData, Transfer</L-2>
                            <L-2 L="EN">Exit, ProcessSwPackage, DeleteTransfer.</L-2>
                          </DESC>
                          <ARGUMENTS>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>size</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Size (in bytes) of the Vehicle Package to be transferred.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-TREF>
                              <DIRECTION>IN</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>id</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Return TransferId.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/ucm/datatypes/ImplementationDataTypes/TransferIdType</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                            <ARGUMENT-DATA-PROTOTYPE>
                              <SHORT-NAME>BlockSize</SHORT-NAME>
                              <DESC>
                                <L-2 L="EN">Size of the blocks to be received with TransferData method.</L-2>
                              </DESC>
                              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-TREF>
                              <DIRECTION>OUT</DIRECTION>
                            </ARGUMENT-DATA-PROTOTYPE>
                          </ARGUMENTS>
                          <FIRE-AND-FORGET>false</FIRE-AND-FORGET>
                          <POSSIBLE-AP-ERROR-REFS>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/OperationNotPermitted</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/InsufficientMemory</POSSIBLE-AP-ERROR-REF>
                            <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/ara/ucm/ApApplicationErrors/NewCampaignDisabled</POSSIBLE-AP-ERROR-REF>
                          </POSSIBLE-AP-ERROR-REFS>
                        </CLIENT-SERVER-OPERATION>

                      </METHODS>
                    </SERVICE-INTERFACE>
                  </ELEMENTS>
                </AR-PACKAGE>
              </AR-PACKAGES>
            </AR-PACKAGE>
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
