<AUTOSAR
    xmlns="http://autosar.org/schema/r4.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>ISOFT</SHORT-NAME>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>PlatformComponents</SHORT-NAME>
                    <AR-PACKAGES>
                        <AR-PACKAGE>
                            <SHORT-NAME>sm</SHORT-NAME>
                            <ELEMENTS>
                                <SDG-DEF>
                                    <SHORT-NAME>Extension</SHORT-NAME>
                                    <SDG-CLASSES>
                                        <SDG-CLASS>
                                            <SHORT-NAME>ARPackage</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:sm:NmHandleToFunctionGroupStateMapping</GID>
                                            <!-- 注意若要定义多个NM-NETWORK-HANDLE到功能组状态的映射,则需多个iSOFT:sm:NmHandleToFunctionGroupStateMapping -->
                                            <EXTENDS-META-CLASS>ARPackage</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>NmHandleToFunctionGroupStateMappingSubclass</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingSubclass:Attributes</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/sm/Extension/NmHandleToFunctionGroupStateMappingAttributes</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>NmHandleToFunctionGroupStateMappingAttributes</SHORT-NAME>
                                            <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingAttributes</GID>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>Type</SHORT-NAME>
                                                <CATEGORY>ENUMERATION</CATEGORY>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingSubclass:Type</GID>
                                                <PATTERN>functionGroupStateToNmHandle|nmHandleActiveToFunctionGroupState|nmHandleInactiveToFunctionGroupState</PATTERN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-FOREIGN-REFERENCE>
                                                    <SHORT-NAME>NmHandle</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingSubclass:NmHandle</GID>
                                                    <DEST-META-CLASS>NmNetworkHandle</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>FunctionGroup</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                    <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingSubclass:FunctionGroup</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/sm/Extension/FunctionGroupInformation</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>FunctionGroupInformation</SHORT-NAME>
                                            <GID>iSOFT:sm:FunctionGroupInformation</GID>
                                            <ATTRIBUTES>
                                                <SDG-FOREIGN-REFERENCE>
                                                    <SHORT-NAME>ContextModeDeclarationGroupPrototype</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingSubclass:ContextModeDeclarationGroupPrototype</GID>
                                                    <DEST-META-CLASS>ModeDeclarationGroupPrototype</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                                <SDG-FOREIGN-REFERENCE>
                                                    <SHORT-NAME>TargetModeDeclaration</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:NmHandleToFunctionGroupStateMappingSubclass:TargetModeDeclaration</GID>
                                                    <DEST-META-CLASS>ModeDeclaration</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>NmHandleToFunctionGroupStateTimeControl</SHORT-NAME>
                                            <GID>iSOFT:sm:NmHandleToFunctionGroupStateTimeControl</GID>
                                            <!--  -->
                                            <EXTENDS-META-CLASS>Machine</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>FGOffTime</SHORT-NAME>
