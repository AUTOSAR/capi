                                                <SHORT-NAME>NetworkOffTime</SHORT-NAME>
                                                <CATEGORY>FLOAT</CATEGORY>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:sm:NmHandleToFunctionGroupStateTimeControl:NetworkOffTime</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>

                                        <SDG-CLASS>
