                                        <SDG-CLASS>
                                            <SHORT-NAME>StateManagementActionItem</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <!-- 子SdgClass没有GID和EXTENDS-META-CLASS属性 -->
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>ItemType</SHORT-NAME>
                                                    <CATEGORY>ENUMERATION</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementActionItem:ItemType</GID>
                                                    <PATTERN>SetFunctionGroupState|Sync</PATTERN>
                                                </SDG-PRIMITIVE-ATTRIBUTE> 
                                                <SDG-FOREIGN-REFERENCE> 
                                                    <SHORT-NAME>ContextModeDeclarationGroupPrototype</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementActionItem:SetFunctionGroupStateContextModeDeclarationGroupPrototype</GID>
                                                    <DEST-META-CLASS>ModeDeclarationGroupPrototype</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                                <SDG-FOREIGN-REFERENCE>
                                                    <SHORT-NAME>TargetModeDeclaration</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementActionItem:SetFunctionGroupStateTargetModeDeclaration</GID>
                                                    <DEST-META-CLASS>ModeDeclaration</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>

                                        <SDG-CLASS>
                                            <SHORT-NAME>StateManagementStateRequest</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <!-- 子SdgClass没有GID和EXTENDS-META-CLASS属性 -->
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>RequestType</SHORT-NAME>
                                                    <CATEGORY>ENUMERATION</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementStateRequest:RequestType</GID>
                                                    <PATTERN>RequestTrigger|RequestError</PATTERN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>Rule</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                    <GID>iSOFT:sm:StateManagementStateRequest:Rule</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/sm/Extension/StateManagementRequestRule</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>

                                        <SDG-CLASS>
                                            <SHORT-NAME>StateManagementRequestRule</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <!-- 子SdgClass没有GID和EXTENDS-META-CLASS属性 -->
                                            <ATTRIBUTES>
                                                <SDG-REFERENCE>
                                                    <SHORT-NAME>ContextStateMachine</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <DEST-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/sm/Extension/StateMachine</DEST-SDG-REF>
                                                </SDG-REFERENCE>
                                                <SDG-FOREIGN-REFERENCE>
                                                    <SHORT-NAME>AssumedCurrentState</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementRequestRule:AssumedCurrentState</GID>
                                                    <DEST-META-CLASS>ModeDeclaration</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>CompareValue</SHORT-NAME>
                                                    <CATEGORY>STRING</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementRequestRule:CompareValue</GID>
                                                    <PATTERN>[1-9][0-9]*|0|ANY</PATTERN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-FOREIGN-REFERENCE>
                                                    <SHORT-NAME>NextState</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:sm:StateManagementRequestRule:NextState</GID>
                                                    <DEST-META-CLASS>ModeDeclaration</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>

                                    </SDG-CLASSES>
                                </SDG-DEF>
                            </ELEMENTS>
                        </AR-PACKAGE>
                    </AR-PACKAGES>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>