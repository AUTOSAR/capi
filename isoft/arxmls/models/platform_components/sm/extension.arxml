                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:sm:NmHandleToFunctionGroupStateTimeControl:FGOffTime</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
