<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
    <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ara</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>ucm</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>ApApplicationErrors</SHORT-NAME>
              <ELEMENTS>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>NewCampaignDisabled</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">New campaigns are disabled, calling AllowCampaign will enable new campaigns.</L-2>
                  </DESC>
                  <ERROR-CODE>31</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>UnexpectedPackage</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The Software Package name does not correspond to the RequestedPackage field value.</L-2>
                  </DESC>
                  <ERROR-CODE>32</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>IncorrectBlock</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The block counter value is not as expected.</L-2>
                  </DESC>
                  <ERROR-CODE>2</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>IncorrectBlockSize</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The size of the block exceeds the provided block size from T ransfer Start or T ransferVehiclePackage.</L-2>
                  </DESC>
                  <ERROR-CODE>30</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>AuthenticationFailed</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Package authentication failed.</L-2>
                  </DESC>
                  <ERROR-CODE>8</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>BlockInconsistent</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Consistency check for transferred block failed.</L-2>
                  </DESC>
                  <ERROR-CODE>25</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>CancelFailed</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Cancel failed.</L-2>
                  </DESC>
                  <ERROR-CODE>16</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>IncompatibleDelta</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Delta package dependency check failed.</L-2>
                  </DESC>
                  <ERROR-CODE>29</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>IncompatiblePackageVersion</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The version of the Software or Vehicle Package to be processed is not compatible with the current version of UCM or UCM Master.</L-2>
                  </DESC>
                  <ERROR-CODE>24</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>IncorrectSize</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The size of the Software or Vehicle Package exceeds the provided size in T ransferStart.</L-2>
                  </DESC>
                  <ERROR-CODE>3</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>InsufficientComputationPower</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Insufficient computation power to perform the requested operation.</L-2>
                  </DESC>
                  <ERROR-CODE>28</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>InsufficientData</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">TransferExit has been called but total transferred data size does not match expected data size provided with TransferStart call.</L-2>
                  </DESC>
                  <ERROR-CODE>6</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>InsufficientMemory</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Insufficient memory to perform operation.</L-2>
                  </DESC>
                  <ERROR-CODE>1</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>InvalidPackageManifest</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Package manifest could not be read.</L-2>
                  </DESC>
                  <ERROR-CODE>13</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>InvalidTransferId</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The Transfer ID is invalid.</L-2>
                  </DESC>
                  <ERROR-CODE>4</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>MissingDependencies</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Activate cannot be performed because of missing dependencies.</L-2>
                  </DESC>
                  <ERROR-CODE>21</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>NotAbleToRevertPackages</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">RevertProcessedSwPackages failed.</L-2>
                  </DESC>
                  <ERROR-CODE>15</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>NotAbleToRollback</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Rollback failed.</L-2>
                  </DESC>
                  <ERROR-CODE>18</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>OldVersion</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Software Package version is too old.</L-2>
                  </DESC>
                  <ERROR-CODE>9</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>OperationNotPermitted</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The operation is not supported in the current context.</L-2>
                  </DESC>
                  <ERROR-CODE>5</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>PackageInconsistent</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Package integrity check failed.</L-2>
                  </DESC>
                  <ERROR-CODE>7</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>ProcessSwPackageCancelled</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The processing operation has been interrupted by a Cancel() call.</L-2>
                  </DESC>
                  <ERROR-CODE>22</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>ProcessedSoftwarePackageInconsistent</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The processed Software Package integrity check has failed.</L-2>
                  </DESC>
                  <ERROR-CODE>23</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>ServiceBusy</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Another processing is already ongoing and therefore the current processing request has to be rejected.</L-2>
                  </DESC>
                  <ERROR-CODE>12</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>TransferInterrupted</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Transfer has been interrupted.</L-2>
                  </DESC>
                  <ERROR-CODE>26</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>UpdateSessionRejected</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Start of an update session was rejected by State Management.</L-2>
                  </DESC>
                  <ERROR-CODE>33</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>PreActivationFailed</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Error during preActivation step.</L-2>
                  </DESC>
                  <ERROR-CODE>19</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>VerificationFailed</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Error during verification step.</L-2>
                  </DESC>
                  <ERROR-CODE>27</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>ResettingMachine</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Resetting machine during verification step.</L-2>
                  </DESC>
                  <ERROR-CODE>34</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>ErrorNoValidProcessing</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Activate cannot be performed because previous processing is invalid.</L-2>
                  </DESC>
                  <ERROR-CODE>20</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>GeneralMemoryError</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">A general memory error occured.</L-2>
                  </DESC>
                  <ERROR-CODE>11</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>GeneralReject</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">General reject.</L-2>
                  </DESC>
                  <ERROR-CODE>10</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>NothingToRevert</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">RevertProcessedSwPackages has been called without prior processing of a Software Package.</L-2>
                  </DESC>
                  <ERROR-CODE>14</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>NothingToRollback</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">Rollback cannot be performed due to no rollback data available.</L-2>
                  </DESC>
                  <ERROR-CODE>17</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR>
                  <SHORT-NAME>SoftwareClusterMissing</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">The Software Cluster is not present in the Machine.</L-2>
                  </DESC>
                  <ERROR-CODE>37</ERROR-CODE>
                  <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/ara/ucm/ApApplicationErrors/UCMErrorDomain</ERROR-DOMAIN-REF>
                </AP-APPLICATION-ERROR>
                <AP-APPLICATION-ERROR-DOMAIN>
                  <SHORT-NAME>UCMErrorDomain</SHORT-NAME>
                  <NAMESPACES>
                    <SYMBOL-PROPS>
                      <SHORT-NAME>ara</SHORT-NAME>
                      <SYMBOL>ara</SYMBOL>
                    </SYMBOL-PROPS>
                    <SYMBOL-PROPS>
                      <SHORT-NAME>ucm</SHORT-NAME>
                      <SYMBOL>ucm</SYMBOL>
                    </SYMBOL-PROPS>
                    <SYMBOL-PROPS>
                      <SHORT-NAME>pkgmgr</SHORT-NAME>
                      <SYMBOL>pkgmgr</SYMBOL>
                    </SYMBOL-PROPS>
                  </NAMESPACES>
                  <VALUE>42</VALUE>
                </AP-APPLICATION-ERROR-DOMAIN>
              </ELEMENTS>
            </AR-PACKAGE>
            <AR-PACKAGE>
              <SHORT-NAME>datatypes</SHORT-NAME>
              <AR-PACKAGES>
                <AR-PACKAGE>
                  <SHORT-NAME>CompuMethods</SHORT-NAME>
                  <ELEMENTS>
                    <COMPU-METHOD>
                      <SHORT-NAME>CampaignStateType</SHORT-NAME>
                      <CATEGORY>TEXTTABLE</CATEGORY>
                      <COMPU-INTERNAL-TO-PHYS>
                        <COMPU-SCALES>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM Master is ready to start a software update campaign.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kIdle</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM master is providing the list of installed SWCLs (GetSwClusterInfo) or computing the list of SWCLs to install (SwPackageInventory).</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kSyncing</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">A vehicle package is being transferred to UCM Master.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kVehiclePackageTransferring</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM Master is transferring software packages to the UCM subordinates.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x03</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x03</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kSoftwarePackage_Transferring</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">The processing of software packages on UCM subordinates is ongoing. The transferring of software packages may still occur.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x04</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x04</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kProcessing</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">The activation of SWCLs on UCM subordinates is ongoing.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x05</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x05</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kActivating</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM Master is performing post-activation checks (OEM specific).</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x06</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x06</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kVehicleChecking</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM Master is rolling-back the activated SWCLs on the UCM subordinates.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x07</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x07</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kCancelling</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">The status file is corrupted.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x08</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x08</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kCorruptedStatusFile</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                        </COMPU-SCALES>
                      </COMPU-INTERNAL-TO-PHYS>
                    </COMPU-METHOD>
                    <COMPU-METHOD>
                      <SHORT-NAME>ActionType</SHORT-NAME>
                      <CATEGORY>TEXTTABLE</CATEGORY>
                      <COMPU-INTERNAL-TO-PHYS>
                        <COMPU-SCALES>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Update of a SoftwareCluster.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kUpdate</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Installation of a new SoftwareCluster.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kInstall</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Removal of a SoftwareCluster.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kRemove</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                        </COMPU-SCALES>
                      </COMPU-INTERNAL-TO-PHYS>
                    </COMPU-METHOD>
                    <COMPU-METHOD>
                      <SHORT-NAME>ActivateOptionType</SHORT-NAME>
                      <CATEGORY>TEXTTABLE</CATEGORY>
                      <COMPU-INTERNAL-TO-PHYS>
                        <COMPU-SCALES>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">The installation has no immediate consequences in terms of other software on the target.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kWaitForReboot</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Restart the application software on the target Machine.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kRestartApplication</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Reboot the whole Machine.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kReboot</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                        </COMPU-SCALES>
                      </COMPU-INTERNAL-TO-PHYS>
                    </COMPU-METHOD>
                    <COMPU-METHOD>
                      <SHORT-NAME>LogLevelType</SHORT-NAME>
                      <CATEGORY>TEXTTABLE</CATEGORY>
