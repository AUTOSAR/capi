                    <COMPU-METHOD>
                      <SHORT-NAME>PackageManagerStatusType</SHORT-NAME>
                      <CATEGORY>TEXTTABLE</CATEGORY>
                      <COMPU-INTERNAL-TO-PHYS>
                        <COMPU-SCALES>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM is ready to start processing if software packages are present.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kIdle</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM has processed one or several packages and waits for additional packages, activation or reversion of processed packages.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kReady</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM is currently in the middle of processing a Software Package, i.e. a client has called ProcessSwPackage.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kProcessing</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM is performing the dependency check and preparing the activation of the processed Software packages.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x03</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x03</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kActivating</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Software changes introduced with processed Software Packages has been activated and executed.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x04</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x04</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kActivated</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM is reverting changes introduced with processed packages.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x05</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x05</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kRollingBack</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Software changes introduced with processed Software Packages has been deactivated and original software is executed.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x06</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x06</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kRolledBack</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Making sure that the system is in a clean state.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x07</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x07</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kCleaningUp</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM (via State Management) is checking that the processed packages have been properly restarted.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x08</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x08</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kVerifying</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">UCM is reverting changes introduced with processed packages after uncontrolled reset.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x09</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x09</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kExceptionRollingBack</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                          <COMPU-SCALE>
                            <DESC>
                              <L-2 L="EN">Making sure that the system is in a clean state after uncontrolled reset.</L-2>
                            </DESC>
                            <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x0A</LOWER-LIMIT>
                            <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x0A</UPPER-LIMIT>
                            <COMPU-CONST>
                              <VT>kExceptionCleaningUp</VT>
                            </COMPU-CONST>
                          </COMPU-SCALE>
                        </COMPU-SCALES>
                      </COMPU-INTERNAL-TO-PHYS>
                    </COMPU-METHOD>
