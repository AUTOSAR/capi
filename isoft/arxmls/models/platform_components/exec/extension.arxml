<AUTOSAR
    xmlns="http://autosar.org/schema/r4.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>ISOFT</SHORT-NAME>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>PlatformComponents</SHORT-NAME>
                    <AR-PACKAGES>
                        <AR-PACKAGE>
                            <SHORT-NAME>exec</SHORT-NAME>
                            <ELEMENTS>
                                <!-- 确定性客户端 确定性同步master扩展，向22看齐-->
                                <SDG-DEF>
                                    <SHORT-NAME>Extension</SHORT-NAME>
                                    <SDG-CLASSES>
                                        <SDG-CLASS>
                                            <SHORT-NAME>ExecIpcInfo</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:exec:ExecIpcInfo</GID>
                                            <EXTENDS-META-CLASS>Process</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>IpcName</SHORT-NAME>
                                                    <CATEGORY>STRING</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:ExecIpcInfo:IpcName</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>ClientIdInfo</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:exec:ClientIdInfo</GID>
                                            <EXTENDS-META-CLASS>Process</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>ClientId</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:ClientIdInfo:ClientId</GID>
                                                    <MAX>65535</MAX>
                                                    <MIN>1</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>ExecDeterministicClient</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:exec:ExecDeterministicClient</GID>
                                            <EXTENDS-META-CLASS>ProcessToMachineMapping</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <!-- CycleTimeValue unit s, just like instance of TimeValue -->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>CycleTimeValue</SHORT-NAME>
                                                    <CATEGORY>FLOAT</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:ExecDeterministicClient:CycleTimeValue</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>NumberOfWorkers</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:ExecDeterministicClient:NumberOfWorkers</GID>
                                                    <MAX>20</MAX>
                                                    <MIN>1</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-REFERENCE>
                                                    <SHORT-NAME>ExecDeterministicClientSubclass</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <DEST-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/exec/Extension/DeterministicSyncMaster</DEST-SDG-REF>
                                                </SDG-REFERENCE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>DeterministicSyncMaster</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:exec:DeterministicSyncMaster</GID>
                                            <EXTENDS-META-CLASS>ProcessToMachineMapping</EXTENDS-META-CLASS>
                                            <CAPTION>true</CAPTION>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>MaxRunCycleLoop</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:DeterministicSyncMaster:MaxRunCycleLoop</GID>
                                                    <MAX>65535</MAX>
                                                    <MIN>1</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>DeterministicSyncMasterSubclass</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:DeterministicSyncMasterSubclass:Attributes</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/exec/Extension/DeterministicSyncMOutOfN</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>DeterministicSyncMOutOfN</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>MinimumNumberOfRequests</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:DeterministicSyncMOutOfN:MinimumNumberOfRequests</GID>
                                                    <MAX>10</MAX>
                                                    <MIN>1</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>NumberOfConnectedClients</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:exec:DeterministicSyncMOutOfN:NumberOfConnectedClients</GID>
                                                    <MAX>10</MAX>
                                                    <MIN>1</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                    </SDG-CLASSES>
                                </SDG-DEF>
                            </ELEMENTS>
                        </AR-PACKAGE>
                    </AR-PACKAGES>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>