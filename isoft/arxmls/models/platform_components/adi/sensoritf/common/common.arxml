          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>CompuMethods</SHORT-NAME>
              <ELEMENTS>
                <COMPU-METHOD>
                  <SHORT-NAME>ArrowDirection</SHORT-NAME>
                  <CATEGORY>TEXTTABLE</CATEGORY>
                  <COMPU-INTERNAL-TO-PHYS>
                    <COMPU-SCALES>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of 0 rad to 0.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kForeward</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of +pi/2 rad to +90.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kLeft</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of -pi/2 rad to -90.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kRight</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow is straight left and has an estimated direction of +pi/2 rad to +90.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x03</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x03</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kStraightLeft</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow is straight right and has an estimated direction of -pi/2 rad to -90.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x04</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x04</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kStraightRight</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of +pi/2 rad to +180.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x05</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x05</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kTurningPointLeft</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of -pi/2rad to -180.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x06</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x06</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kTurningPointRight</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of +pi/4 rad to +45.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x07</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x07</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>k45DegLeft</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Arrow has an estimated direction of -pi/4 rad to -45.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x08</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x08</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>k45DegRight</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">No arrow is present.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x09</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x09</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kNoArrow</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The arrow direction is unknown.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x0A</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x0A</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kUnknown</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                    </COMPU-SCALES>
                  </COMPU-INTERNAL-TO-PHYS>
                </COMPU-METHOD>
                <COMPU-METHOD>
                  <SHORT-NAME>BlockageStatus</SHORT-NAME>
                  <CATEGORY>TEXTTABLE</CATEGORY>
                  <COMPU-INTERNAL-TO-PHYS>
                    <COMPU-SCALES>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The sensor is completely blocked, no more feature and functionality working due to blockage condition.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kFullBlockage</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The sensor has detected a blockage condition which has a significant impact on sensor performance (e.g. range).</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kPartialBlockageHighImpact</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The sensor has detected a blockage condition which already has impact on sensor performance (e.g. range).</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kPartialBlockageMediumImpact</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The sensor detects that a blockage condition is present or is increasing, but the degree of blockage has not yet had a significant impact on sensor performance and functionality.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x03</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x03</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kPartialBlockageLowImpact</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The full specified range is blocked, due to e.g. a pixel defect. This segment may overlap with other segments.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x04</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x04</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kDefect</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN"> Normal mode.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x05</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x05</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kNone</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">The blockage Status is unknown.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x06</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x06</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kUnknown</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                    </COMPU-SCALES>
                  </COMPU-INTERNAL-TO-PHYS>
                </COMPU-METHOD>
                <COMPU-METHOD>
                  <SHORT-NAME>ColourModelType</SHORT-NAME>
                  <CATEGORY>TEXTTABLE</CATEGORY>
                  <COMPU-INTERNAL-TO-PHYS>
                    <COMPU-SCALES>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Grey scale – 1 colour value is used for grey value.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x00</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x00</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT> kGrey</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Red, green, blue – 3 colour values are used for the values for red, green, blue.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x01</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x01</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kRGB</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Hue, saturation, value – 3 colour values are used for the values for hue, saturation, value.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x02</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x02</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kHSV</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Luminance and colour coordinates U, V – 3 colour values are used for the values for hue, saturation, value.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x03</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x03</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kLUV</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                      <COMPU-SCALE>
                        <DESC>
                          <L-2 L="EN">Each value reference a pre-defined colour – 1 colour value.</L-2>
                        </DESC>
                        <LOWER-LIMIT INTERVAL-TYPE="CLOSED">0x04</LOWER-LIMIT>
                        <UPPER-LIMIT INTERVAL-TYPE="CLOSED">0x04</UPPER-LIMIT>
                        <COMPU-CONST>
                          <VT>kColourList</VT>
                        </COMPU-CONST>
                      </COMPU-SCALE>
                    </COMPU-SCALES>
                  </COMPU-INTERNAL-TO-PHYS>
                </COMPU-METHOD>
