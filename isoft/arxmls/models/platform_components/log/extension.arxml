<AUTOSAR
    xmlns="http://autosar.org/schema/r4.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>ISOFT</SHORT-NAME>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>PlatformComponents</SHORT-NAME>
                    <AR-PACKAGES>
                        <AR-PACKAGE>
                            <SHORT-NAME>log</SHORT-NAME>
                            <ELEMENTS>
                                <!-- Daemontcp连接配置、日志文件缓存和切割配置 -->
                                <SDG-DEF>
                                    <SHORT-NAME>Extension</SHORT-NAME>
                                    <SDG-CLASSES>
                                        <SDG-CLASS>
                                            <SHORT-NAME>LogDaemonEthernetConfiguration</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:log:LogDaemonEthernetConfiguration</GID>
                                            <EXTENDS-META-CLASS>Machine</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>LogDaemonEthernetConfigurationSubclass</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                    <GID>iSOFT:log:LogDaemonEthernetConfigurationSubclass:Attributes</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/log/Extension/EthernetConfigurationUnit</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>EthernetConfigurationUnit</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <ATTRIBUTES>
                                                <SDG-FOREIGN-REFERENCE>
                                                <SHORT-NAME>Connector</SHORT-NAME>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:log:EthernetConfigurationUnit:Connector</GID>
                                                <DEST-META-CLASS>CommunicationConnector</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>ServicePort</SHORT-NAME>
                                                <CATEGORY>INTEGER</CATEGORY>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:log:EthernetConfigurationUnit:ServicePort</GID>
                                                <MAX>65534</MAX>
                                                <MIN>1</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <!-- 如果日志文件需要缓存切割，使用相同文件的通道都需要配置映射相同规则
                                                 文件缓存和文件切割，可以只配置一项，也可以都配置
                                             -->
                                            <SHORT-NAME>DltLogChannelToFileExtensionOperationMapping</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:log:DltLogChannelToFileExtensionOperationMapping</GID>
                                            <EXTENDS-META-CLASS>Machine</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-FOREIGN-REFERENCE>
                                                <SHORT-NAME>LogChannel</SHORT-NAME>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY-INFINITE>true</UPPER-MULTIPLICITY-INFINITE>
                                                <GID>iSOFT:log:DltLogChannelToFileExtensionOperationMapping:LogChannel</GID>
                                                <DEST-META-CLASS>DltLogChannel</DEST-META-CLASS>
                                                </SDG-FOREIGN-REFERENCE>
                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>DltLogChannelToFileExtensionOperationMappingSubclass</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:log:DltLogChannelToFileExtensionOperationMappingSubclass:Attributes</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/log/Extension/LogFileExtensionOperation</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>LogFileExtensionOperation</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>FileBuffer</SHORT-NAME>
                                                <CATEGORY>INTEGER</CATEGORY>
                                                <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:log:LogFileExtensionOperation:FileBuffer</GID>
                                                <MAX>18446744073709551615</MAX>
                                                <MIN>0</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>

                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>PlainText</SHORT-NAME>
                                                <CATEGORY>BOOLEAN</CATEGORY>
                                                <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:log:LogFileExtensionOperation:PlainText</GID>
 
                                                </SDG-PRIMITIVE-ATTRIBUTE>


                                                <SDG-AGGREGATION-WITH-VARIATION>
                                                    <SHORT-NAME>LogFileExtensionOperationSubclass</SHORT-NAME>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:log:LogFileExtensionOperationSubclass:Attributes</GID>
                                                    <VARIATION>false</VARIATION>
                                                    <SUB-SDG-REF DEST="SDG-CLASS">/ISOFT/PlatformComponents/log/Extension/LogFileRotateRule</SUB-SDG-REF>
                                                </SDG-AGGREGATION-WITH-VARIATION>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>LogFileRotateRule</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>FileSize</SHORT-NAME>
                                                <CATEGORY>INTEGER</CATEGORY>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:log:LogFileRotateRule:FileSize</GID>
                                                <MAX>18446744073709551615</MAX>
                                                <MIN>0</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                <SHORT-NAME>FileCount</SHORT-NAME>
                                                <CATEGORY>INTEGER</CATEGORY>
                                                <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                <GID>iSOFT:log:LogFileRotateRule:FileCount</GID>
                                                <MAX>18446744073709551615</MAX>
                                                <MIN>0</MIN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                        <SDG-CLASS>
                                            <SHORT-NAME>DltMessageNamespace</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:log:DltMessageNamespace</GID>
                                            <EXTENDS-META-CLASS>DltMessageCollectionSet</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>Namespace</SHORT-NAME>
                                                    <CATEGORY>STRING</CATEGORY>
                                                    <LOWER-MULTIPLICITY>1</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:log:DltMessageNamespace:Namespace</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                    </SDG-CLASSES>
                                </SDG-DEF>
                            </ELEMENTS>
                        </AR-PACKAGE>
                    </AR-PACKAGES>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>