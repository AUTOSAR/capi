<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>ISOFT</SHORT-NAME>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>PlatformComponents</SHORT-NAME>
                    <AR-PACKAGES>
                        <AR-PACKAGE>
                            <SHORT-NAME>tsync</SHORT-NAME>
                            <ELEMENTS>
                                <SDG-DEF>
                                    <SHORT-NAME>Extension</SHORT-NAME>
                                    <SDG-CLASSES>
                                        <SDG-CLASS>
                                            <SHORT-NAME>GlobalTimeDomainExtension</SHORT-NAME>
                                            <CATEGORY>ISOFT_EXTENSION</CATEGORY>
                                            <GID>iSOFT:tsync:GlobalTimeDomainExtension</GID>
                                            <EXTENDS-META-CLASS>GlobalTimeDomain</EXTENDS-META-CLASS>
                                            <ATTRIBUTES>
                                                <!-- GlobalTimePropagationDelay 参考prs, 固定路径传输延迟，也作为传输延迟的初始值, 单位秒-->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>GlobalTimePropagationDelay</SHORT-NAME>
                                                    <CATEGORY>FLOAT</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:tsync:GlobalTimeDomainExtension:GlobalTimePropagationDelay</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>

                                                <!-- MasterSlaveConflictDetection 参考prs, 主从冲突检测 -->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>MasterSlaveConflictDetection</SHORT-NAME>
                                                    <CATEGORY>BOOLEAN</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:tsync:GlobalTimeDomainExtension:MasterSlaveConflictDetection</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                                <!-- CrcTimeFlagsTxSecured 参考prs, autosar格式时间主控制那些字段参与crc校验-->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>CrcTimeFlagsTxSecured</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:tsync:GlobalTimeDomainExtension:CrcTimeFlagsTxSecured</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>

                                                <!-- GlobalTimeSequenceCounterJumpWidth 参考prs, 连续sync报文的序列号最大跳转-->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>GlobalTimeSequenceCounterJumpWidth</SHORT-NAME>
                                                    <CATEGORY>INTEGER</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:tsync:GlobalTimeDomainExtension:GlobalTimeSequenceCounterJumpWidth</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>

                                                <!-- UseSteadyClock 时间从是否为稳固时钟-->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>UseSteadyClock</SHORT-NAME>
                                                    <CATEGORY>BOOLEAN</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:tsync:GlobalTimeDomainExtension:UseSteadyClock</GID>
                                                </SDG-PRIMITIVE-ATTRIBUTE>

                                                <!-- TimeStampType 使用何种时间戳 -->
                                                <SDG-PRIMITIVE-ATTRIBUTE>
                                                    <SHORT-NAME>TimeStampType</SHORT-NAME>
                                                    <CATEGORY>ENUMERATION</CATEGORY>
                                                    <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                                                    <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                                                    <GID>iSOFT:tsync:GlobalTimeDomainExtension:TimeStampType</GID>
                                                    <PATTERN>Software|Hardware</PATTERN>
                                                </SDG-PRIMITIVE-ATTRIBUTE>
                                            </ATTRIBUTES>
                                        </SDG-CLASS>
                                    </SDG-CLASSES>
                                </SDG-DEF>
                            </ELEMENTS>
                        </AR-PACKAGE>
                    </AR-PACKAGES>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>