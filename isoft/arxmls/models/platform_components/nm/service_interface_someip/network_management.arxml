                      <METHOD-ID>0x4027</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>GetEtherStateMachineState</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/GetEtherStateMachineState</METHOD-REF>
                      <METHOD-ID>0x4028</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>RequestDetectNode</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/RequestDetectNode</METHOD-REF>
                      <METHOD-ID>0x4029</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>NotifyWakeup</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/NotifyWakeup</METHOD-REF>
                      <METHOD-ID>0x402A</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>SetMessageCtrlType</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/SetMessageCtrlType</METHOD-REF>
                      <METHOD-ID>0x402B</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>

                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>GetMessageCtrlType</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/GetMessageCtrlType</METHOD-REF>
                      <METHOD-ID>0x402C</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>

                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>GetInitState</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/GetInitState</METHOD-REF>
                      <METHOD-ID>0x402D</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>

                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>GetPassivePnRequestList</SHORT-NAME>
                      <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/NetworkStateServiceInterfaces/NetworkState/GetPassivePnRequestList</METHOD-REF>
                      <METHOD-ID>0x4030</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                  </METHOD-DEPLOYMENTS>
                  <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/NetworkStateServiceInterfaces/NetworkState</SERVICE-INTERFACE-REF>

                  <EVENT-GROUPS>
                    <SOMEIP-EVENT-GROUP>
                      <SHORT-NAME>NetworkCurrentStateEventgroup1</SHORT-NAME>
                      <EVENT-GROUP-ID>1</EVENT-GROUP-ID>
                      <EVENT-REFS>
                        <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/ara/nm/nmSomeipDeployments/NetworkState/NetworkCurrentState/NetworkCurrentState_notifier</EVENT-REF>
                      </EVENT-REFS>
                    </SOMEIP-EVENT-GROUP>
                    <SOMEIP-EVENT-GROUP>
                      <SHORT-NAME>NetworkRequestedStateEventgroup</SHORT-NAME>
                      <EVENT-GROUP-ID>2</EVENT-GROUP-ID>
                      <EVENT-REFS>
                        <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/ara/nm/nmSomeipDeployments/NetworkState/NetworkRequestedState/NetworkRequestedState_notifier</EVENT-REF>
                      </EVENT-REFS>
                    </SOMEIP-EVENT-GROUP>
                    <SOMEIP-EVENT-GROUP>
                      <SHORT-NAME>NotifyPresentNodeList1</SHORT-NAME>
                      <EVENT-GROUP-ID>3</EVENT-GROUP-ID>
                      <EVENT-REFS>
                        <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/ara/nm/nmSomeipDeployments/NetworkState/NotifyPresentNodeList</EVENT-REF>
                      </EVENT-REFS>
                    </SOMEIP-EVENT-GROUP>
                    <SOMEIP-EVENT-GROUP>
                      <SHORT-NAME>NotifyEtherStateChanged1</SHORT-NAME>
                      <EVENT-GROUP-ID>4</EVENT-GROUP-ID>
                      <EVENT-REFS>
                        <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/ara/nm/nmSomeipDeployments/NetworkState/NotifyEtherStateChanged</EVENT-REF>
                      </EVENT-REFS>
                    </SOMEIP-EVENT-GROUP>
                    <SOMEIP-EVENT-GROUP>
                      <SHORT-NAME>NotifyPassivePnRequest1</SHORT-NAME>
                      <EVENT-GROUP-ID>5</EVENT-GROUP-ID>
                      <EVENT-REFS>
                        <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/ara/nm/nmSomeipDeployments/NetworkState/NotifyPassivePnRequest</EVENT-REF>
                      </EVENT-REFS>
                    </SOMEIP-EVENT-GROUP>
                    <SOMEIP-EVENT-GROUP>
                      <SHORT-NAME>NotifyPassivePnRelease1</SHORT-NAME>
                      <EVENT-GROUP-ID>6</EVENT-GROUP-ID>
                      <EVENT-REFS>
                        <EVENT-REF DEST="SOMEIP-EVENT-DEPLOYMENT">/ara/nm/nmSomeipDeployments/NetworkState/NotifyPassivePnRelease</EVENT-REF>
                      </EVENT-REFS>
                    </SOMEIP-EVENT-GROUP>
                  </EVENT-GROUPS>
                  <SERVICE-INTERFACE-ID>60</SERVICE-INTERFACE-ID>
                  <SERVICE-INTERFACE-VERSION>
                    <MAJOR-VERSION>1</MAJOR-VERSION>
                    <MINOR-VERSION>0</MINOR-VERSION>
                  </SERVICE-INTERFACE-VERSION>
                </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              </ELEMENTS>
            </AR-PACKAGE>          
          </AR-PACKAGES>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
