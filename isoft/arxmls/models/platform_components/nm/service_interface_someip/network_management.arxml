                      <METHOD-ID>0x4026</METHOD-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-METHOD-DEPLOYMENT>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>SetEtherStateMachineSate</SHORT-NAME>
