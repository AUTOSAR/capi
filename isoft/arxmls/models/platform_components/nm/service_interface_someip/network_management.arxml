<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ara</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>nm</SHORT-NAME>
          <AR-PACKAGES>
            <AR-PACKAGE>
              <SHORT-NAME>nmSomeipDeployments</SHORT-NAME>
              <ELEMENTS>
                <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
                  <SHORT-NAME>NetworkState</SHORT-NAME>
                  <EVENT-DEPLOYMENTS>
                    <SOMEIP-EVENT-DEPLOYMENT>
                      <SHORT-NAME>NotifyEtherStateChanged</SHORT-NAME>
                      <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/NetworkStateServiceInterfaces/NetworkState/NotifyEtherStateChanged</EVENT-REF>
                      <EVENT-ID>0x4021</EVENT-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-EVENT-DEPLOYMENT>
                    <SOMEIP-EVENT-DEPLOYMENT>
                      <SHORT-NAME>NotifyPresentNodeList</SHORT-NAME>
                      <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/NetworkStateServiceInterfaces/NetworkState/NotifyPresentNodeList</EVENT-REF>
                      <EVENT-ID>0x4022</EVENT-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-EVENT-DEPLOYMENT>
                    <SOMEIP-EVENT-DEPLOYMENT>
                      <SHORT-NAME>NotifyPassivePnRequest</SHORT-NAME>
                      <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/NetworkStateServiceInterfaces/NetworkState/NotifyPassivePnRequest</EVENT-REF>
                      <EVENT-ID>0x402E</EVENT-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-EVENT-DEPLOYMENT>
                    <SOMEIP-EVENT-DEPLOYMENT>
                      <SHORT-NAME>NotifyPassivePnRelease</SHORT-NAME>
                      <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/NetworkStateServiceInterfaces/NetworkState/NotifyPassivePnRelease</EVENT-REF>
                      <EVENT-ID>0x402F</EVENT-ID>
                      <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                    </SOMEIP-EVENT-DEPLOYMENT>
                  </EVENT-DEPLOYMENTS>
                  <FIELD-DEPLOYMENTS>
                    <SOMEIP-FIELD-DEPLOYMENT>
                      <SHORT-NAME>NetworkCurrentState</SHORT-NAME>
                      <FIELD-REF DEST="FIELD">/NetworkStateServiceInterfaces/NetworkState/NetworkCurrentState</FIELD-REF>
                      <GET>
                        <SHORT-NAME>NetworkCurrentState_getter</SHORT-NAME>
                        <METHOD-ID>0x4422</METHOD-ID>
                        <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                      </GET>
                      <NOTIFIER>
                        <SHORT-NAME>NetworkCurrentState_notifier</SHORT-NAME>
                        <EVENT-ID>0x4423</EVENT-ID>
                        <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                      </NOTIFIER>
                    </SOMEIP-FIELD-DEPLOYMENT>
                    <SOMEIP-FIELD-DEPLOYMENT>
                      <SHORT-NAME>NetworkRequestedState</SHORT-NAME>
                      <FIELD-REF DEST="FIELD">/NetworkStateServiceInterfaces/NetworkState/NetworkRequestedState</FIELD-REF>
                      <GET>
                        <SHORT-NAME>NetworkRequestedState_getter</SHORT-NAME>
                        <METHOD-ID>0x4023</METHOD-ID>
                        <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                      </GET>
                      <NOTIFIER>
                        <SHORT-NAME>NetworkRequestedState_notifier</SHORT-NAME>
                        <EVENT-ID>0x4024</EVENT-ID>
                        <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                      </NOTIFIER>
                      <SET>
                        <SHORT-NAME>NetworkRequestedState_setter</SHORT-NAME>
                        <METHOD-ID>0x4025</METHOD-ID>
                        <TRANSPORT-PROTOCOL>TCP</TRANSPORT-PROTOCOL>
                      </SET>
                    </SOMEIP-FIELD-DEPLOYMENT>
                  </FIELD-DEPLOYMENTS>
                  <METHOD-DEPLOYMENTS>
                    <SOMEIP-METHOD-DEPLOYMENT>
                      <SHORT-NAME>SetDefaultEtherIp</SHORT-NAME>
