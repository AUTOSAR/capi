<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>NetworkErrors</SHORT-NAME>
      <ELEMENTS>
        <AP-APPLICATION-ERROR-DOMAIN>
          <SHORT-NAME>GenericErrors</SHORT-NAME>
          <NAMESPACES>
            <SYMBOL-PROPS>
              <SHORT-NAME>ara</SHORT-NAME>
              <SYMBOL>ara</SYMBOL>
            </SYMBOL-PROPS>
            <SYMBOL-PROPS>
              <SHORT-NAME>nm</SHORT-NAME>
              <SYMBOL>nm</SYMBOL>
            </SYMBOL-PROPS>
          </NAMESPACES>
          <VALUE>45</VALUE>
        </AP-APPLICATION-ERROR-DOMAIN>
        <AP-APPLICATION-ERROR>
          <SHORT-NAME>GenericFailure</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Generic failure.</L-2>
          </DESC>
          <ERROR-CODE>12</ERROR-CODE>
          <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/NetworkErrors/GenericErrors</ERROR-DOMAIN-REF>
        </AP-APPLICATION-ERROR>
        <AP-APPLICATION-ERROR>
          <SHORT-NAME>InvalidConfiguration</SHORT-NAME>
          <DESC>
            <L-2 L="EN">Configuration is invalid.</L-2>
          </DESC>
          <ERROR-CODE>5</ERROR-CODE>
          <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/NetworkErrors/SpecificErrors</ERROR-DOMAIN-REF>
        </AP-APPLICATION-ERROR>
        <AP-APPLICATION-ERROR>
          <SHORT-NAME>InvalidLogicNetworkParameter</SHORT-NAME>
          <DESC>
            <L-2 L="EN">LogicNetworkParameter is invalid.</L-2>
          </DESC>
          <ERROR-CODE>6</ERROR-CODE>
          <ERROR-DOMAIN-REF DEST="AP-APPLICATION-ERROR-DOMAIN">/NetworkErrors/SpecificErrors</ERROR-DOMAIN-REF>
        </AP-APPLICATION-ERROR>
        <AP-APPLICATION-ERROR-DOMAIN>
          <SHORT-NAME>SpecificErrors</SHORT-NAME>
          <NAMESPACES>
            <SYMBOL-PROPS>
              <SHORT-NAME>ara</SHORT-NAME>
              <SYMBOL>ara</SYMBOL>
            </SYMBOL-PROPS>
            <SYMBOL-PROPS>
              <SHORT-NAME>nm</SHORT-NAME>
              <SYMBOL>nm</SYMBOL>
            </SYMBOL-PROPS>
          </NAMESPACES>
          <VALUE>44</VALUE>
        </AP-APPLICATION-ERROR-DOMAIN>
      </ELEMENTS>
    </AR-PACKAGE>
    <AR-PACKAGE>
      <SHORT-NAME>NetworkStateServiceInterfaces</SHORT-NAME>
      <ELEMENTS>
        <SERVICE-INTERFACE>
          <SHORT-NAME>NetworkState</SHORT-NAME>
          <NAMESPACES>
            <SYMBOL-PROPS>
              <SHORT-NAME>ara</SHORT-NAME>
              <SYMBOL>ara</SYMBOL>
            </SYMBOL-PROPS>
            <SYMBOL-PROPS>
              <SHORT-NAME>nm</SHORT-NAME>
              <SYMBOL>nm</SYMBOL>
            </SYMBOL-PROPS>
          </NAMESPACES>
          <MAJOR-VERSION>1</MAJOR-VERSION>
          <MINOR-VERSION>0</MINOR-VERSION>
          <!-- 
          <EVENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>testEvent</SHORT-NAME>
              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/ByteArray</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
          </EVENTS>
          <METHODS>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>EchoMethod</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>msg</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>echo</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/HelloWorldErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/HelloWorldErrors/InvalidConfigString</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
          </METHODS> -->
          
          <EVENTS>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>NotifyPresentNodeList</SHORT-NAME>
              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/ByteArray</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>NotifyEtherStateChanged</SHORT-NAME>
              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/NMEtherStateChangedType</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>NotifyPassivePnRequest</SHORT-NAME>
              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/PassivePNInform</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>
            <VARIABLE-DATA-PROTOTYPE>
              <SHORT-NAME>NotifyPassivePnRelease</SHORT-NAME>
              <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/PassivePNInform</TYPE-TREF>
            </VARIABLE-DATA-PROTOTYPE>

          </EVENTS>
          <FIELDS>
            <!-- NetworkCurrentState -->
            <FIELD>
                <SHORT-NAME>NetworkCurrentState</SHORT-NAME>
                <DESC>
                <L-2 L="EN">PNC/VLAN/Physical Network is currently active or not.</L-2>
                </DESC>
                <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/NetworkStateType</TYPE-TREF>
                <HAS-GETTER>true</HAS-GETTER>
                <HAS-NOTIFIER>true</HAS-NOTIFIER>
                <HAS-SETTER>false</HAS-SETTER>
            </FIELD>
            <!-- NetworkRequestedState -->
            <FIELD>
                <SHORT-NAME>NetworkRequestedState</SHORT-NAME>
                <DESC>
                <L-2 L="EN">Request or Release PNC/VLAN/Physical Network to get active or to release.</L-2>
                </DESC>
                <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/NetworkStateType</TYPE-TREF>
                <HAS-GETTER>true</HAS-GETTER>
                <HAS-NOTIFIER>true</HAS-NOTIFIER>
                <HAS-SETTER>true</HAS-SETTER>
            </FIELD>
          </FIELDS>
          <METHODS>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>SetDefaultEtherIp</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>SetEtherStateMachineSate</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethState</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/NetworkStateType</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>GetEtherStateMachineState</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethState</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/NetworkStateType</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>RequestDetectNode</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>NotifyWakeup</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>SetMessageCtrlType</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ctrType</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/MessageCtrlType</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>GetMessageCtrlType</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ctrType</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ara/nm/MessageCtrlType</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>GetInitState</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>stateCode</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
            <CLIENT-SERVER-OPERATION>
              <SHORT-NAME>GetPassivePnRequestList</SHORT-NAME>
              <ARGUMENTS>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>ethIp</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>IN</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
                <ARGUMENT-DATA-PROTOTYPE>
                  <SHORT-NAME>pnList</SHORT-NAME>
                  <TYPE-TREF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/ISOFT/SharedTypes/String</TYPE-TREF>
                  <DIRECTION>OUT</DIRECTION>
                </ARGUMENT-DATA-PROTOTYPE>
              </ARGUMENTS>
              <POSSIBLE-AP-ERROR-REFS>
                <POSSIBLE-AP-ERROR-REF DEST="AP-APPLICATION-ERROR">/NetworkErrors/GenericFailure</POSSIBLE-AP-ERROR-REF>
              </POSSIBLE-AP-ERROR-REFS>
            </CLIENT-SERVER-OPERATION>
          </METHODS>
        </SERVICE-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>

