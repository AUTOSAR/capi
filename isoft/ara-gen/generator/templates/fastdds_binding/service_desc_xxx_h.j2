{%if field.has_getter%}
struct {{service.service_deployment.name}}{{field.name}}GetterDesc : {{service.service_deployment.name}}ServiceDesc {
    static constexpr auto methodId() { return types::MethodId{ {{service.absolute_namespace}}::{{service.deployment_id}}Field_Get{{field.name}}_Hash}; }
    //static constexpr auto inputTopicName()  {return types::TopicName{"{{field.getter_request_topic_name}}"};}
    //static constexpr auto outputTopicName()  {return types::TopicName{"{{field.getter_reply_topic_name}}"};}
    //static constexpr auto qosProfile(){return types::QosProfile{"default"};};
    static constexpr auto descMode() { return kField;}
    static constexpr auto getname() { return "{{field.name}}Getter";}

    using request_t = {{service.absolute_namespace}}::{{service.deployment_id}}Field_Request;
    using reply_t = {{service.absolute_namespace}}::{{service.deployment_id}}Field_Reply;

    using input_t = {{service.absolute_namespace}}::{{service.deployment_id}}Field_Get{{field.name}}_In;
    using output_t = {{service.absolute_namespace}}::{{service.deployment_id}}Field_Get{{field.name}}_Out;
    using result_t = {{service.absolute_namespace}}::{{service.deployment_id}}Field_Get{{field.name}}_Result;

    using ara_output_t = {{field.type_declaration}};
    using signature_t = ara_output_t();
    using invoker_t = std::function<ara::core::Future<ara_output_t>(request_t const&)>;

    static void SetRequestData(request_t& request, input_t const& data) {
    request.data().get{{field.name}}(data);
  }
  template <typename... Args>
  static void SetRequestData(request_t& request, Args const&... args) {
    input_t data;
    struct {
      dds::rpc::UnusedMember dummy;
    } tmp = {args...};
    data.dummy(tmp.dummy);
    request.data().get{{field.name}}(data);
  }
   template<typename Promise>
  static void SetPromiseValue(Promise& promise, reply_t const& reply) {
    if (reply.data().get{{field.name}}()._d() == dds::RETCODE_OK) {
        std::unique_ptr<ara_output_t> result = std::make_unique<ara_output_t>();
        ara::com::internal::fastdds::ConvertFromIdl(reply.data().get{{field.name}}().result_().return_(), *result);
        promise.set_value(*result);
    } else if (reply.data().get{{field.name}}()._d() == dds::RETCODE_ERROR) {
        promise.SetError(ara::com::internal::fastdds::ConvertFromIdl(reply.data().get{{field.name}}().error()));
    } else {
        assert(false);
    }
  }
  static void SetReplyData(reply_t &reply, ara::core::Result<ara_output_t> const &data){
    result_t result;
    if (data.HasValue()){
        std::unique_ptr< output_t> output = std::make_unique<output_t>();
        ara::com::internal::fastdds::ConvertToIdl(data.Value(), output->return_());
        result.result_(*output);
    }else{
        result.error(ara::com::internal::fastdds::ConvertToIdl(data.Error()));
    }

    reply.data().get{{field.name}}(result);
  }

  template <typename T>
  static auto WrapHandler(T &handler){
    return [handler]({{service.service_deployment.name}}{{field.name}}GetterDesc::request_t const &request){
      (void)request;
      return handler();
    };
  }


};
{% endif %}
