struct {{service.service_deployment.name}}{{method.name}}Desc:{{service.service_deployment.name}}ServiceDesc {
    static constexpr auto methodId() {return types::MethodId{ {{service.absolute_namespace}}::{{service.deployment_id}}Method_{{method.name}}_Hash };}
    static constexpr auto possibleErrors() {return {{method.name}}Errors;}
{% if method.is_reliable %}
    static constexpr auto isReliable() {return bool{true};}
{% else %}
    static constexpr auto isReliable() {return bool{false};}
{% endif %}
    //static constexpr auto inputTopicName()  {return types::TopicName{"{{method.request_topic}}"};}
    //static constexpr auto outputTopicName()  {return types::TopicName{"{{method.reply_topic}}"};}
    //static constexpr auto qosProfile(){return types::QosProfile{"default"};};
    static constexpr auto descMode() { return kOther;}
    static constexpr auto getname() { return "{{method.name}}";}

    using request_t = {{service.absolute_namespace}}::{{service.deployment_id}}Method_Request;
    using reply_t = {{service.absolute_namespace}}::{{service.deployment_id}}Method_Reply;

    using input_t = {{service.absolute_namespace}}::{{service.deployment_id}}Method_{{method.name}}_In;
    using output_t = {{service.absolute_namespace}}::{{service.deployment_id}}Method_{{method.name}}_Out;
    using result_t = {{service.absolute_namespace}}::{{service.deployment_id}}Method_{{method.name}}_Result;

{% if method.get_output_args %}
    using ara_output_t = {{service.absolute_namespace}}::{{service.name}}::{{method.name}}Output;
{% else %}
    using ara_output_t = void;
{% endif %}

    using signature_t = ara_output_t({%- for arg in method.get_input_args -%}const {{arg.type_declaration}}& {{ arg.name }}{% if not loop.last %},{% endif %}{%- endfor -%});
{% if method.is_fire_and_forget %}
    using invoker_t = std::function<ara_output_t(request_t const&)>;
{%else%}
    using invoker_t = std::function<ara::core::Future<ara_output_t>(request_t const&)>;
{%endif%}
    static void SetRequestData(request_t& request, input_t const& data) {
      request.data().{{method.name}}(data);
  }
    template <typename... Args>
    static void SetRequestData(request_t &request, Args const &...args){
        std::unique_ptr<input_t> data = std::make_unique<input_t>();
        struct
        {
{%if method.get_input_args%}
{%for arg in method.get_input_args%}
             {{arg.type_declaration}} const *{{ arg.name }};
{% endfor %}
{%else%}
           dds::rpc::UnusedMember dummy;
{%endif%}
        } tmp = {&args...};
{%if method.get_input_args%}
{%for arg in method.get_input_args%}
    ara::com::internal::fastdds::ConvertToIdl(*tmp.{{ arg.name }}, data->{{ arg.name }}());
{% endfor %}
{%else%}
        data->dummy(tmp.dummy);
{%endif%}
        request.data().{{method.name}}(*data);
    }

  template<typename Promise>
  static void SetPromiseValue(Promise& promise, reply_t const& reply) {
    if (reply.data().{{method.name}}()._d() == dds::RETCODE_OK) {
{% if method.get_output_args %}
      std::unique_ptr<ara_output_t> result = std::make_unique<ara_output_t>();
        ara::com::internal::fastdds::ConvertFromIdl(reply.data().{{method.name}}().result(), *result);
        promise.set_value(*result);
{% else %}
      promise.set_value();
{% endif %}
    } else if (reply.data().{{method.name}}()._d() == dds::RETCODE_ERROR) {
      promise.SetError(ara::com::internal::fastdds::ConvertFromIdl(reply.data().{{method.name}}().error()));
    } else {
      assert(false);
    }
  }

{% if method.get_output_args %}
  static void SetReplyData(reply_t& reply, ara::core::Result<ara_output_t> const& data){
    result_t result;
    if (data.HasValue()){
      std::unique_ptr<output_t> output = std::make_unique<output_t>();
      ara::com::internal::fastdds::ConvertToIdl(data.Value(),*output);
      result.result(*output);
    } else {
      result.error(ara::com::internal::fastdds::ConvertToIdl(data.Error()));
    }

    reply.data().{{method.name}}(result);
  }
{% else %}
  static void SetReplyData(reply_t& reply, ara::core::Result<ara_output_t> const& data){
    result_t result;
    if (data.HasValue()) {
      result.result(output_t());
    } else {
      result.error(ara::com::internal::fastdds::ConvertToIdl(data.Error()));
    }

    reply.data().{{method.name}}(result);
  }
{% endif %}
    static void GetRequestData(const request_t& request{%for arg in method.get_input_args%},{{arg.type_declaration}}& {{ arg.name }}{% endfor %}) {
    (void)request;
{%for arg in method.get_input_args%}
    ara::com::internal::fastdds::ConvertFromIdl(request.data().{{method.name}}().{{arg.name}}(), {{arg.name}});
{% endfor %}
     return ;
  }

};
{% endfor %}


