    template <typename Promise>
    static void SetPromiseValue(Promise &promise, reply_t const &reply) {
        if (reply.data().set{{field.name}}()._d() == dds::RETCODE_OK) {
            std::unique_ptr<ara_output_t> result = std::make_unique<ara_output_t>();
            ara::com::internal::fastdds::ConvertFromIdl(reply.data().set{{field.name}}().result_().return_(), *result);
            promise.set_value(*result);
        } else if (reply.data().set{{field.name}}()._d() == dds::RETCODE_ERROR) {
            promise.SetError(ara::com::internal::fastdds::ConvertFromIdl(reply.data().set{{field.name}}().error()));
        } else {
