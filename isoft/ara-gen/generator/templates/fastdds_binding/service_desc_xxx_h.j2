        std::unique_ptr<input_t> data = std::make_unique<input_t>();
        struct {
            {{field.type_view.qualified_cpp_name}} const *{{field.name}};
        } tmp = {&args...};
        ara::com::internal::fastdds::ConvertToIdl(*tmp.{{ field.name }}, data->{{ field.name }}());
        request.data().set{{field.name}}(*data);
