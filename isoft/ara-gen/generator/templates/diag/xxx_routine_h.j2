{% extends "utils/header_base.j2" %}
{% block header %}{{super()}}{% endblock %}
{% block source %}

#include <cstdint>

#include <ara/core/future.h>
#include <ara/core/instance_specifier.h>
#include <ara/diag/internal/continuation_manager.h>
#include <ara/diag/internal/raw_routine.h>
#include <ara/diag/internal/types.h>
#include <ara/diag/cancellation_handler.h>
#include <ara/diag/meta_info.h>
#include <ara/diag/reentrancy.h>

{% if item.includeDatatypeList %}{% for datatypeItem in item.includeDatatypeList %}
#include "{{ datatypeItem }}"
{% endfor %}{% endif %}

{% if item.namespaces %}{% for ns in item.namespaces %}
namespace {{ns}} {
{% endfor %}{% endif %}

class {{item.name}} : public ara::diag::internal::RawRoutine {
 public:

{% for method in item.methodList %}
{% if method.ob and method.ob.out %}
    struct {{method.ob.out.name}} {
{%for out_item in method.ob.out.outType%}
        {{out_item.outputType}} {{out_item.name}};
{%endfor%}

        using TagEnumerable = void;
        template <typename F>
        void enumerate(F& fun) {
{%for out_item in method.ob.out.outType%}
            fun({{out_item.name}});
{% endfor %}
        }
    };
{% endif %}

{% endfor %}

    {{item.name}}(const ara::core::InstanceSpecifier& specifier, ara::diag::ReentrancyType reentrancyType);

    virtual ~{{item.name}}() noexcept = default;

{% for method in item.methodList %}
{% if method.ob and method.ob.out and method.ob.inList%}
    virtual ara::core::Future<{{method.ob.out.name}}> {{method.name}}({%for write_item in method.ob.inList%}{{write_item.inType}} {{write_item.name}},{%endfor%}ara::diag::MetaInfo& metaInfo, ara::diag::CancellationHandler cancellationHandler) = 0;
{%endif%}
{%endfor%}


 protected:

{% for method in item.methodList %}
{% if method.ob and method.ob.out %}
    virtual ara::core::Future<ara::diag::internal::Chunk> Raw{{method.name}}(
        ara::diag::internal::Chunk& requestData, ara::diag::MetaInfo& metaInfo,
        ara::diag::CancellationHandler cancellationHandler) override;
{%endif%}
{%endfor%}

};

{% if item.namespaces %}{% for ns in item.namespaces|reverse %}
}  // namespace {{ ns }}
{% endfor %}{% endif %}

{% endblock source %}
{% block footer %}{{super()}}{% endblock %}
