{%- for service in services %}
/* service {{service.name}}------------------------------- */
{% for namespace in service.namespaces %}
module {{namespace}} {
{% endfor %}
    interface {{service.name}} {
        /* methods --------------------------------------------- */
{% for method in service.methods %}
{% set comma = joiner(", ") %}
        void {{method.name}}(
{%- for argument in method.get_input_args -%}
{{comma()}}in {{argument.type_view.qualified_idl_name}} {{argument.name}}
{%- endfor -%}
{%- for argument in method.get_output_args -%}
{{comma()}}out {{argument.type_view.qualified_idl_name}} {{argument.name}}
{%- endfor -%}
        );
{% endfor %}
        /* events ---------------------------------------------- */
{% for event in service.events %}
        /* event definition for {{event.name}}; underlying type is {{event.type_view.qualified_idl_name}} */
{% endfor %}
        /* fields ---------------------------------------------- */
{% for field in service.all_fields %}
        /* field definition for {{field.name}}; underlying type is {{field.type_view.qualified_idl_name}} */
{% if field.has_setter %}
        void Set{{field.name}}(in {{field.type_view.qualified_idl_name}} value);
{% endif %}
{% if field.has_getter %}
        void Get{{field.name}}(out {{field.type_view.qualified_idl_name}} value);
{% endif %}
{% endfor %}
    };
{% for namespace in service.namespaces|reverse -%}
}; // module {{namespace}}
{% endfor %}
{% endfor %}
