#ifndef __ARA_LOG_INTERNAL_DLTMESSAGE_DEFINE_H__
#define __ARA_LOG_INTERNAL_DLTMESSAGE_DEFINE_H__

using char8_t = char;

{% for item in dltMessageList %}

struct {{ item.name }}Type
{
    std::int32_t  id{ {{ item.messageId }} };
    std::int32_t  lineNumber{ {{ item.lineNumber }} };
    char8_t const* sourceFile{ "{{ item.sourceFile }}" };
    char8_t const* typeInfo{ "{{ item.typeInfo }}" };
    std::int32_t argsNum{ {{ item.argumentNum }} };
};
constexpr static {{ item.name }}Type {{ item.name }};
{% endfor %}

#endif // __ARA_LOG_INTERNAL_DLTMESSAGE_DEFINE_H__
