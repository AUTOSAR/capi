# gen code 
function(add_aragen)
	set(options ALL FORCE_PKGPATH_FALLBACK)
	set(oneValueArgs DESTINATION  EXECUTABLE SCHEMA TARGET)
	set(multiValueArgs PROCESS_FQN  ARXMLS)
	cmake_parse_arguments(add_aragen_ARGS "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

	set(add_aragen_COMMON_ARGS
		${SKIP_RC_OPTION}
		${SINGLE_PRCESS_MODE}
		-o ${add_aragen_ARGS_DESTINATION}
		-g CODE
		${add_aragen_PKGPATH_ARGUMENT}
		${SOMEIP_LIBS_OPTION}
		${DDS_LIBS_OPTION}
		${IPC_LIBS_OPTION}
		${ICC_LIBS_OPTION}
		${SOA_ELEMENT_CPP_DEF_STYLE}
	)

	if(add_aragen_ARGS_FORCE_PKGPATH_FALLBACK)
		set(add_aragen_COMMON_ARGS ${add_aragen_COMMON_ARGS} "--force-pkg-path-fallback")
	endif()

	if(DEFINED add_aragen_ARGS_PROCESS_FQN AND NOT ${add_aragen_ARGS_PROCESS_FQN} STREQUAL "Unknown" )
		string(JOIN "," process ${add_aragen_ARGS_PROCESS_FQN})
		set(add_aragen_COMMON_ARGS ${add_aragen_COMMON_ARGS} -p ${process})
	endif()

	if(DEFINED add_aragen_ARGS_EXECUTABLE AND NOT ${add_aragen_ARGS_EXECUTABLE} STREQUAL "Unknown" )
		set(add_aragen_COMMON_ARGS ${add_aragen_COMMON_ARGS} -e ${add_aragen_ARGS_EXECUTABLE})
	endif()

	if(DEBUG_ARA_GEN)
		set(command_line --list-files ${add_aragen_COMMON_ARGS} ${add_aragen_ARGS_ARXMLS})
		string(JOIN " " command_line ${command_line})
		message(STATUS "add_aragen aragen command:${ARAGEN_PATH} ${command_line}")
	endif()

	execute_process(
		COMMAND
		${ARAGEN_PATH}
		--list-files
		${add_aragen_COMMON_ARGS}
		${add_aragen_ARGS_ARXMLS}
		ERROR_VARIABLE aragen_errors
		OUTPUT_VARIABLE aragen_outputs
		RESULT_VARIABLE aragen_return
		WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
	)
	if(NOT aragen_return EQUAL 0)
		message(STATUS "aragen_outputs: ${aragen_outputs}")
		message(STATUS "aragen_errors: ${aragen_errors}")
		message(FATAL_ERROR "aragen failed!")
	endif()

	# 将目录换到文件，因为目录内文件的变化不会触发修改重编译
	set(_ARXML_FILES )
	FOREACH(it ${add_aragen_ARGS_ARXMLS})
	string(TOLOWER ${it} _it2)
	if(${_it2} MATCHES ".*\\.arxml")
			list(APPEND _ARXML_FILES ${it}) 
	else()
			string(CONCAT _FIND ${it} "/*.arxml")
			file(GLOB_RECURSE _Ret_GetArxmlsFromDIR ${_FIND}) 
			list(APPEND _ARXML_FILES ${_Ret_GetArxmlsFromDIR})
	endif()
	ENDFOREACH(it)
	list(REMOVE_DUPLICATES _ARXML_FILES)
	# Add input .arxmls to the list of input files to the configuration process.
	# This is needed so that CMake is re-run, if any of this files are changed,
	# because it might affect which output files the generator produces.
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_ARXML_FILES})
	# Export the list of files (sources and headers) to the caller
	set(aragen_hdrs)
	set(aragen_srcs)
	set(aragen_idls)
	foreach(f IN LISTS aragen_outputs)
		if(f MATCHES ".*\\.h")
			list(APPEND aragen_hdrs ${f})
		elseif(f MATCHES ".*\\.cpp")
			list(APPEND aragen_srcs ${f})
		elseif(f MATCHES ".*\\.idl")
			list(APPEND aragen_idls ${f})
		endif()
	endforeach()
	set(${add_aragen_ARGS_TARGET}_HEADERS ${aragen_hdrs} PARENT_SCOPE)
	set(${add_aragen_ARGS_TARGET}_SOURCES ${aragen_srcs} PARENT_SCOPE)
	set(${add_aragen_ARGS_TARGET}_IDLS ${aragen_idls} PARENT_SCOPE)

	# Finally setup custom command/target for invoking the generator
	# (this will happen during build, i.e. upon `make' invocation)
	add_custom_command(
		OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${add_aragen_ARGS_TARGET}.stamp
		COMMAND
		${ARAGEN_PATH}
		${add_aragen_COMMON_ARGS}
		${add_aragen_VALIDATE_ARGUMENT}
		${add_aragen_ARGS_ARXMLS}
		COMMAND
		${CMAKE_COMMAND} -E touch ${CMAKE_CURRENT_BINARY_DIR}/${add_aragen_ARGS_TARGET}.stamp
		DEPENDS ${_ARXML_FILES}
		BYPRODUCTS ${aragen_outputs}
		WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
	)

	if(add_aragen_ARGS_ALL)
		set(add_aragen_ALL_VALUE "ALL")
	else()
		set(add_aragen_ALL_VALUE "")
	endif()
	add_custom_target(${add_aragen_ARGS_TARGET} ${add_aragen_ALL_VALUE} DEPENDS ${add_aragen_ARGS_TARGET}.stamp)
endfunction()

