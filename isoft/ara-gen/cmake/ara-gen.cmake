# gen code(gen fastdds code && include add_aragen) TODO add EXECUTABLE
function(add_fastdds)
	set(options "")
	set(oneValueArgs APP_NAME DESTINATION SCHEMA TARGET EXECUTABLE GENERATED_LIB)
	set(multiValueArgs PROCESS_FQN ARXMLS)

	cmake_parse_arguments(add_fastdds_ARGS "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})

	set(GENERATED_TARGET ${add_fastdds_ARGS_APP_NAME}Generated)
	set(FASTDDS_GENERATED_LIB ${add_fastdds_ARGS_TARGET}Lib)
	set(FASTDDS_GEN_DEST ${add_fastdds_ARGS_DESTINATION}/net-bindings/)
	set(ARA_GEN_INCLUDE_DEST ${add_fastdds_ARGS_DESTINATION}/includes)


	add_aragen(
		DESTINATION ${add_fastdds_ARGS_DESTINATION}
		TARGET ${add_fastdds_ARGS_TARGET}
		PROCESS_FQN ${add_fastdds_ARGS_PROCESS_FQN}
		EXECUTABLE ${add_fastdds_ARGS_EXECUTABLE}
		ARXMLS ${add_fastdds_ARGS_ARXMLS}
	)

	find_path(FASTDDSGEN_DIR fastddsgen) 
	set(FASTDDSGEN_PATH ${FASTDDSGEN_DIR}/fastddsgen)
	set(fastdds_srcs)
	set(fastdds_idls)
	list(APPEND fastdds_srcs ${${add_fastdds_ARGS_TARGET}_SOURCES})
	set(_depends)
	#创建目录
	set(IDL_STAMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/stamp)
	set(IDL_TMP_DIR ${CMAKE_CURRENT_BINARY_DIR}/tmp)
	execute_process( 
		COMMAND ${CMAKE_COMMAND} -E make_directory ${IDL_STAMP_DIR}
		COMMAND ${CMAKE_COMMAND} -E make_directory ${IDL_TMP_DIR}
		)
	if(FASTDDS_ROS2)
		set(FASTDDS_GEN_OPTS -replace -cs -typeros2 )
	else()
		set(FASTDDS_GEN_OPTS -replace -cs )
	endif()
	foreach(IDL_PATH IN LISTS ${add_fastdds_ARGS_TARGET}_IDLS)
		list(APPEND fastdds_idls  ${IDL_PATH})
		get_filename_component(IDL_DIR ${IDL_PATH} DIRECTORY)
		get_filename_component(IDL_NAME ${IDL_PATH} NAME)
		string(REPLACE ".idl" ".cxx" IDS_CXX1 ${IDL_PATH})
		string(REPLACE ".idl" "PubSubTypes.h" IDL_PUBSUBTYPES_H ${IDL_PATH})
		string(REPLACE ".idl" "PubSubTypes.cxx" IDS_CXX2 ${IDL_PATH})
		string(REPLACE ".idl" "TypeObjectSupport.cxx" IDS_TYPEOBJECTSUPPORT_CXX ${IDL_PATH})
		string(REPLACE ".idl" "CdrAux.hpp" IDS_CDRAUX_H ${IDL_PATH})


		list(APPEND fastdds_srcs ${IDS_CXX1})
		list(APPEND fastdds_srcs ${IDS_TYPEOBJECTSUPPORT_CXX})
		list(APPEND fastdds_srcs ${IDS_CXX2})

		execute_process( 
			COMMAND ${CMAKE_COMMAND} -E make_directory ${IDL_DIR}
		)

		execute_process( 
			COMMAND ${CMAKE_COMMAND} -E touch ${IDS_CXX1}
			COMMAND ${CMAKE_COMMAND} -E touch ${IDS_CXX2}
			COMMAND ${CMAKE_COMMAND} -E touch ${IDL_PUBSUBTYPES_H}
			COMMAND ${CMAKE_COMMAND} -E touch ${IDS_CDRAUX_H}
			COMMAND ${CMAKE_COMMAND} -E touch ${IDS_TYPEOBJECTSUPPORT_CXX}
			)
		add_custom_command(
			OUTPUT  ${IDL_STAMP_DIR}/${IDL_NAME}.stamp
			COMMAND
					${FASTDDSGEN_PATH} ${FASTDDS_GEN_OPTS} -t ${IDL_TMP_DIR} -I ${add_fastdds_ARGS_DESTINATION}/net-bindings/fastdds_idl ${IDL_PATH}
			COMMAND
				${CMAKE_COMMAND} -E touch ${IDL_STAMP_DIR}/${IDL_NAME}.stamp
			DEPENDS ${IDL_PATH}
			#BYPRODUCTS ${jsongen_outputs}
			WORKING_DIRECTORY "${add_fastdds_ARGS_DESTINATION}/net-bindings/"
		)
		list(APPEND _depends ${IDL_STAMP_DIR}/${IDL_NAME}.stamp)
	endforeach()

	add_custom_target(${helper_ARGS_TARGET}_IDLS ALL DEPENDS ${_depends} ${add_fastdds_ARGS_TARGET})
	add_library(${FASTDDS_GENERATED_LIB} OBJECT  ${add_fastdds_ARGS_DESTINATION}/helper_libary.cpp )
	add_dependencies(${FASTDDS_GENERATED_LIB} ${helper_ARGS_TARGET}_IDLS)
	target_compile_definitions(${FASTDDS_GENERATED_LIB} PRIVATE HAS_FASTDDS_BINDING)
	target_include_directories(${FASTDDS_GENERATED_LIB}
		PRIVATE ${ARA_GEN_INCLUDE_DEST}
				${CMAKE_CURRENT_SOURCE_DIR}
				${FASTDDS_GEN_DEST}
				${FASTDDS_GEN_DEST}/fastdds_idl
				${CMAKE_INSTALL_PREFIX}/include)

	set(${add_fastdds_ARGS_TARGET}_SOURCES  ${fastdds_srcs} PARENT_SCOPE)
endfunction()
