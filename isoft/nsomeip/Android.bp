cc_library_static {
    name: "libnsomeip",
    //overrides: ["libnsomeip"],
    srcs: ["src/nsomeip/*/*.c"],
    vendor: true,

    //stl: "none",
    c_std: "c99",
    cflags: [
        "-DDEBUG",
        "-fexceptions",
        "-Wno-macro-redefined",
        "-Wno-error=missing-field-initializers",
        "-Wno-error=typedef-redefinition",
        "-Wno-error=sometimes-uninitialized",
    ],
    cppflags: [
        "-Wno-error=c++11-narrowing",
        "-Wno-error=uninitialized",
        "-ffunction-sections",
        "-fdata-sections",
        "-Wno-error=deprecated-copy"
    ],
    local_include_dirs: ["include", "src"],
    export_include_dirs: ["include/"],
    shared_libs: ["libm"],
    static_libs: ["libnai"],
    export_generated_headers: ["gen_nsi_config_h"],
    generated_headers: [
        "gen_nsi_config_h"
    ],
    compile_multilib: "64",
    min_sdk_version: "33"
}
genrule {
    name: "gen_nsi_config_h",
    cmd : "touch $(out)",
    srcs: ["include/nsomeip/nsi_config.h"],
    out: ["nsomeip/config/nsi_config.h"],    
}
