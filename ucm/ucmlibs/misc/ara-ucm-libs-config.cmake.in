#
# Config file for the ara::per package.
# This file exports the PER CMake targets which should be passed to the
# target_link_libraries command.
#
# ================================================================

include(CMakeFindDependencyMacro)

set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)
find_dependency(ara-core-types)
find_dependency(ara-log)
find_dependency(isoft-crc)
find_dependency(isoft-manifestreader)
# CMake as of v3.12.2 does not support passing through COMPONENTS with find_dependency(),
find_package(ZLIB)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/ara-ucm-libs-targets.cmake")
