include(CMakeFindDependencyMacro)

set(THREADS_PREFER_PTHREAD_FLAG ON)

find_dependency(Threads)
find_dependency(nai)
find_dependency(isoft-ipc)
find_dependency(isoft-naicpp)
find_dependency(ara-log)
find_dependency(ara-core-types)
if(ARA_WITH_CRYPTO)
    find_dependency(ara-crypto)
    message(STATUS "idsm protocol lib install with crypto")
endif(ARA_WITH_CRYPTO)

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/ara-idsm-targets.cmake")