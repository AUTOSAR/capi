{
    "name": "capidevcontainer",
    "build": {
        "dockerfile": "Dockerfile",
        "options": [
            "--tag=capi-devcontainer-image:latest"
        ]
    },
    // Enable the control of the hosts docker from the devcontainer.
    "features":  {"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}},
    // Enable completion for docker commands
    "onCreateCommand": "mkdir -p ~/.local/share/bash-completion/completions && docker completion bash > ~/.local/share/bash-completion/completions/docker && mkdir -p ~/.oh-my-zsh/completions && docker completion zsh > ~/.oh-my-zsh/completions/_docker",
    // Initialize network that can be used to connect to other machines.
    // It is fine if this already exists.
    // If there is an error connecting to the network try rebuilding the devcontainer.
    "initializeCommand": "docker network create --label com.docker.compose.network=shared_network capi_shared_network || true",
    "runArgs": [
        "--network=capi_shared_network"
    ]
}