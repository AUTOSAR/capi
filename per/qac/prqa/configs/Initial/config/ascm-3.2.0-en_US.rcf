            </rule>
            <rule id="A4-10-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A4-10-1.html">
              <text>Only nullptr literal shall be used as the null-pointer-constant.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1024" mapped="yes"/>
                <message component="qacpp" id="3124" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-0-1.html">
              <text>The value of an expression shall be the same under any order of evaluation that the standard permits.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3220" mapped="yes"/>
                <message component="qacpp" id="3221" mapped="yes"/>
                <message component="qacpp" id="3222" mapped="yes"/>
                <message component="qacpp" id="3223" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-0-2.html">
              <text>The condition of an if-statement and the condition of an iteration statement shall have type bool.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4079" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-0-3.html">
              <text>The declaration of objects shall contain no more than two levels of pointer indirection.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2424" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-0-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-0-4.html">
              <text>Pointer arithmetic shall not be used with pointers to non-final classes.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3723" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-1.html">
              <text>Literal values shall not be used apart from type initialization, otherwise symbolic names shall be used instead.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4400" mapped="yes"/>
                <message component="qacpp" id="4402" mapped="yes"/>
                <message component="qacpp" id="4403" mapped="yes"/>
                <message component="qacpp" id="4404" mapped="yes"/>
                <message component="qacpp" id="4405" mapped="yes"/>
                <message component="qacpp" id="4406" mapped="yes"/>
                <message component="qacpp" id="4407" mapped="yes"/>
                <message component="qacpp" id="4408" mapped="yes"/>
                <message component="qacpp" id="4409" mapped="yes"/>
                <message component="qacpp" id="4413" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-2.html">
              <text>Variables shall not be implicitly captured in a lambda expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3880" mapped="yes"/>
                <message component="qacpp" id="3881" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-3.html">
              <text>Parameter list (possibly empty) shall be included in every lambda expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1107" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-4.html">
              <text>A lambda expression object shall not outlive any of its reference-captured objects.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4706" mapped="yes"/>
                <message component="qacpp" id="4707" mapped="yes"/>
                <message component="qacpp" id="4708" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-7.html">
              <text>The underlying type of lambda expression shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3913" mapped="yes"/>
                <message component="qacpp" id="3914" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-2-2.html">
              <text>Traditional C-style casts shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3080" mapped="yes"/>
                <message component="qacpp" id="3082" mapped="yes"/>
                <message component="qacpp" id="3160" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-2-3.html">
              <text>A cast shall not remove any const or volatile qualification from the type of a pointer or reference.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3060" mapped="yes"/>
                <message component="qacpp" id="3061" mapped="yes"/>
                <message component="qacpp" id="3066" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-2-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-2-4.html">
              <text>reinterpret_cast shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3049" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-2-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-2-5.html">
              <text>An array or container shall not be accessed beyond its range.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2840" mapped="yes"/>
                <message component="qacpp" id="2841" mapped="yes"/>
                <message component="qacpp" id="2842" mapped="yes"/>
                <message component="qacpp" id="2843" mapped="yes"/>
                <message component="qacpp" id="2844" mapped="no"/>
                <!-- Possible: Dereference of an invalid pointer value. -->
                <message component="qacpp" id="2930" mapped="yes"/>
                <message component="qacpp" id="2931" mapped="yes"/>
                <message component="qacpp" id="2932" mapped="yes"/>
                <message component="qacpp" id="2933" mapped="yes"/>
                <message component="qacpp" id="2934" mapped="no"/>
                <!-- Possible: Computing an invalid pointer value. -->
                <message component="qacpp" id="3526" mapped="yes"/>
                <message component="qacpp" id="3527" mapped="yes"/>
                <message component="qacpp" id="3528" mapped="yes"/>
                <message component="qacpp" id="3529" mapped="yes"/>
                <message component="qacpp" id="3530" mapped="yes"/>
                <message component="qacpp" id="3531" mapped="yes"/>
                <message component="qacpp" id="3532" mapped="yes"/>
                <message component="qacpp" id="3533" mapped="yes"/>
                <message component="qacpp" id="3534" mapped="no"/>
                <!-- Possible: Overflowing the bounds of a container. -->
                <message component="qacpp" id="4880" mapped="yes"/>
                <message component="qacpp" id="4881" mapped="yes"/>
                <message component="qacpp" id="4882" mapped="yes"/>
                <message component="qacpp" id="4883" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-2-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-2-6.html">
              <text>The operands of a logical &amp;&amp; or || shall be parenthesized if the operands contain binary operators.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3700" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-3-2.html">
              <text>Null pointers shall not be dereferenced.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2810" mapped="yes"/>
                <message component="qacpp" id="2811" mapped="yes"/>
                <message component="qacpp" id="2812" mapped="yes"/>
                <message component="qacpp" id="2813" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-3-3.html">
              <text>Pointers to incomplete class types shall not be deleted.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3329" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-5-1.html">
              <text>A pointer to member shall not access non-existent class members.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3125" mapped="yes"/>
                <message component="qacpp" id="3126" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-6-1.html">
              <text>The right hand operand of the integer division or remainder operators shall not be equal to zero.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0015" mapped="yes"/>
                <message component="qacpp" id="0435" mapped="yes"/>
                <message component="qacpp" id="2831" mapped="yes"/>
                <message component="qacpp" id="2832" mapped="yes"/>
                <message component="qacpp" id="2833" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-10-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-10-1.html">
              <text>A pointer to member virtual function shall only be tested for equality with null-pointer-constant.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3271" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-16-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-16-1.html">
              <text>The ternary conditional operator shall not be used as a sub-expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3382" mapped="yes"/>
                <message component="qacpp" id="3383" mapped="yes"/>
                <message component="qacpp" id="3389" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-2-1.html">
              <text>Move and copy assignment operators shall either move or respectively copy base classes and data members of a class, without any side effects.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A6-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-2-2.html">
              <text>Expression statements shall not be explicit calls to constructors of temporary objects only.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3110" mapped="yes"/>
                <message component="qacpp" id="3111" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-4-1.html">
              <text>A switch statement shall have at least two case-clauses, distinct from the default label.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4016" mapped="yes"/>
                <message component="qacpp" id="4018" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-5-1.html">
              <text>A for-loop that loops through all elements of the container and does not use its loop-counter shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4687" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-5-2.html">
              <text>A for loop shall contain a single loop-counter which shall not have floating-point type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4232" mapped="yes"/>
                <message component="qacpp" id="4234" mapped="yes"/>
                <message component="qacpp" id="4243" mapped="yes"/>
                <message component="qacpp" id="4244" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-6-1.html">
              <text>The goto statement shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4000" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-1.html">
              <text>Constexpr or const specifiers shall be used for immutable data declaration.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4117" mapped="yes"/>
                <message component="qacpp" id="4118" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-2.html">
              <text>The constexpr specifier shall be used for values that can be determined at compile time.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A7-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-3.html">
              <text>CV-qualifiers shall be placed on the right hand side of the type that is a typedef or a using name.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1106" mapped="yes"/>
                <message component="qacpp" id="1108" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-4.html">
              <text>The register keyword shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5213" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-5.html">
              <text>The auto specifier shall not be used apart from following cases: (1) to declare that a variable has the same type as return type of a function call, (2) to declare that a variable has the same type as initializer of non-fundamental type, (3) to declare parameters of a generic lambda expression, (4) to declare a function template using trailing return type syntax.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4128" mapped="yes"/>
                <message component="qacpp" id="4129" mapped="yes"/>
                <message component="qacpp" id="4130" mapped="yes"/>
                <message component="qacpp" id="4131" mapped="yes"/>
                <message component="qacpp" id="4132" mapped="yes"/>
                <message component="qacpp" id="4133" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-6.html">
              <text>The typedef specifier shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5214" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-7.html">
              <text>Each expression statement and identifier declaration shall be placed on a separate line.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4107" mapped="yes"/>
                <message component="qacpp" id="4108" mapped="yes"/>
                <message component="qacpp" id="4109" mapped="yes"/>
                <message component="qacpp" id="4110" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-8.html">
              <text>A non-type specifier shall be placed before a type specifier in a declaration.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1104" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-1-9" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-1-9.html">
              <text>A class, structure, or enumeration shall not be declared in the definition of its type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1101" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-2-1.html">
              <text>An expression with enum underlying type shall only have values corresponding to the enumerators of the enumeration.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4895" mapped="yes"/>
                <message component="qacpp" id="4896" mapped="yes"/>
                <message component="qacpp" id="4897" mapped="yes"/>
                <message component="qacpp" id="4898" mapped="yes"/>
                <message component="qacpp" id="4899" mapped="no"/>
              </enforcement>
            </rule>
            <rule id="A7-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-2-2.html">
              <text>Enumeration underlying base type shall be explicitly defined.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2436" mapped="yes"/>
                <message component="qacpp" id="2437" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-2-3.html">
              <text>Enumerations shall be declared as scoped enum classes.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2438" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-2-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-2-4.html">
              <text>In an enumeration, either (1) none, (2) the first or (3) all enumerators shall be initialized. </text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2422" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-3-1.html">
              <text>All overloads of a function shall be visible from where it is called.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3820" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-4-1.html">
              <text>The asm declaration shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1100" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-5-1.html">
              <text>A function shall not return a reference or a pointer to a parameter that is passed by reference to const.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4624" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-5-2.html">
              <text>Functions shall not call themselves, either directly or indirectly.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4048" mapped="yes"/>
                <message component="qacpp" id="4049" mapped="yes"/>
                <message component="rcma" id="1520" mapped="yes"/>
                <message component="rcma" id="1521" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A7-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-6-1.html">
              <text>Functions declared with the [[noreturn]] attribute shall not return.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2886" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-2-1.html">
              <text>When declaring function templates, the trailing return type syntax shall be used if the return type depends on the type of parameters.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2661" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-1.html">
              <text>Functions shall not be defined using the ellipsis notation.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2012" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-2.html">
              <text>All exit paths from a function with non-void return type shall have an explicit return statement with an expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2888" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-5.html">
              <text>"consume" parameters declared as X &amp;&amp; shall always be moved from.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3857" mapped="no"/>
                <!-- Rvalue reference parameter to function was not moved from. -->
                <message component="qacpp" id="3858" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-6.html">
              <text>"forward" parameters declared as T &amp;&amp; shall always be forwarded.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3846" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-7.html">
              <text>"in" parameters for "cheap to copy" types shall be passed by value.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2008" mapped="no"/>
                <!-- This function parameter exceeds the maximum size allowed for the "being passed by" value (8 bytes). -->
                <message component="qacpp" id="2009" mapped="no"/>
              </enforcement>
            </rule>
            <rule id="A8-4-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-8.html">
              <text>Output parameters shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A8-4-9" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-9.html">
              <text>"in-out" parameters declared as T &amp; shall be modified.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4283" mapped="yes"/>
                <message component="qacpp" id="4287" mapped="yes"/>
                <message component="qacpp" id="4675" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-10" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-10.html">
              <text>A parameter shall be passed by reference if it can't be NULL</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A8-4-11" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-11.html">
              <text>A smart pointer shall only be used as a parameter type if it expresses lifetime semantics</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A8-4-12" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-12.html">
              <text>A std::unique_ptr shall be passed to a function as: (1) a copy to express the function assumes ownership (2) an lvalue reference to express that the function replaces the managed object. </text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2662" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-13" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-13.html">
              <text>A std::shared_ptr shall be passed to a function as: (1) a copy to express the function shares ownership (2) an lvalue reference to express that the function replaces the managed object (3) a const lvalue reference to express that the function retains a reference count. </text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A8-5-0" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-5-0.html">
              <text>All memory shall be initialized before it is read.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2961" mapped="no"/>
                <!-- Definite: Using value of uninitialized automatic object '::ara::per::manifest::PManifestReader_Per::_ReadStorageData_Kv(,p={c::isoft::manifestreader::Manifest})::@BLK7::@for::size'.-->
                <message component="qacpp" id="2962" mapped="yes"/>
                <message component="qacpp" id="2963" mapped="yes"/>
                <message component="qacpp" id="2971" mapped="yes"/>
                <message component="qacpp" id="2972" mapped="yes"/>
                <message component="qacpp" id="2973" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-5-1.html">
              <text>In an initialization list, the order of initialization shall be following: (1) virtual base classes in depth and left to right order of the inheritance graph, (2) direct base classes in left to right order of inheritance list, (3) non-static data members in the order they were declared in the class definition.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4053" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-5-2.html">
              <text>Braces shall be used to indicate and match the structure in the non-zero initialization of arrays and structures.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2322" mapped="yes"/>
                <message component="qacpp" id="2323" mapped="yes"/>
                <message component="qacpp" id="2324" mapped="yes"/>
                <message component="qacpp" id="2327" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-5-3.html">
              <text>A variable of type auto shall not be initialized using {} or ={} braced-initialization.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2325" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A9-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A9-3-1.html">
              <text>Member functions shall not return non-const "raw" pointers or references to private or protected data owned by the class.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4024" mapped="no"/>
                <!-- This function returns a non-const handle to private or protected member data. -->
                <message component="qacpp" id="4625" mapped="yes"/>
                <message component="qacpp" id="4627" mapped="no"/>
                <!-- This function returns a non-const handle to data pointed to by a private or protected member. -->
              </enforcement>
            </rule>
            <rule id="A9-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A9-5-1.html">
              <text>Unions shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2176" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A9-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A9-6-1.html">
              <text>Data types used for interfacing with hardware or conforming to communication protocols shall be trivial, standard-layout and only contain members of types with defined sizes.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2304" mapped="yes"/>
                <message component="qacpp" id="2305" mapped="yes"/>
                <message component="qacpp" id="2306" mapped="yes"/>
                <message component="qacpp" id="2308" mapped="yes"/>
                <message component="qacpp" id="2309" mapped="yes"/>
                <message component="qacpp" id="2321" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A10-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-1-1.html">
              <text>Class shall not be derived from more than one base class which is not an interface class.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2156" mapped="yes"/>
                <message component="qacpp" id="2157" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A10-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-2-1.html">
              <text>Non-virtual public or protected member functions shall not be redefined in derived classes.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2121" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A10-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-3-1.html">
              <text>Virtual function declaration shall contain exactly one of the three specifiers: (1) virtual, (2) override, (3) final.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2135" mapped="yes"/>
                <message component="qacpp" id="2136" mapped="yes"/>
                <message component="qacpp" id="2653" mapped="yes"/>
                <message component="qacpp" id="2654" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A10-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-3-2.html">
              <text>Each overriding virtual function shall be declared with the override or final specifier.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2135" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A10-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-3-3.html">
              <text>Virtual functions shall not be introduced in a final class.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2655" mapped="yes"/>
                <message component="qacpp" id="2656" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A10-3-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-3-5.html">
              <text>A user-defined assignment operator shall not be virtual.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2657" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A11-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A11-0-2.html">
              <text>A type defined as struct shall: (1) provide only public data members, (2) not provide any special member functions or methods, (3) not be a base of another struct or class, (4) not inherit from another struct or class.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2174" mapped="no"/>
                <!-- struct IsArray final : std::false_type {} -->
                <message component="qacpp" id="2197" mapped="yes"/>
                <message component="qacpp" id="2198" mapped="no"/>
                <!-- This struct explicitly defines member functions. -->
              </enforcement>
            </rule>
            <rule id="A11-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A11-3-1.html">
              <text>Friend declarations shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2107" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-0-1.html">
              <text>If a class declares a copy or move operation, or a destructor, either via "=default", "=delete", or via a user-provided declaration, then all others of these five special member functions shall be declared as well.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2609" mapped="yes"/>
                <message component="qacpp" id="2610" mapped="yes"/>
                <message component="qacpp" id="2611" mapped="yes"/>
                <message component="qacpp" id="2612" mapped="yes"/>
                <message component="qacpp" id="2613" mapped="yes"/>
                <message component="qacpp" id="2614" mapped="yes"/>
                <message component="qacpp" id="2615" mapped="yes"/>
                <message component="qacpp" id="2616" mapped="yes"/>
                <message component="qacpp" id="2617" mapped="yes"/>
                <message component="qacpp" id="2618" mapped="yes"/>
                <message component="qacpp" id="2619" mapped="yes"/>
                <message component="qacpp" id="2647" mapped="yes"/>
                <message component="qacpp" id="2648" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-0-2.html">
              <text>Bitwise operations and operations that assume data representation in memory shall not be performed on objects.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4726" mapped="yes"/>
                <message component="qacpp" id="4727" mapped="yes"/>
                <message component="qacpp" id="4728" mapped="yes"/>
                <message component="qacpp" id="4729" mapped="yes"/>
                <message component="qacpp" id="4731" mapped="yes"/>
                <message component="qacpp" id="4732" mapped="yes"/>
                <message component="qacpp" id="4733" mapped="yes"/>
                <message component="qacpp" id="4734" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-1-1.html">
              <text>Constructors shall explicitly initialize all virtual base classes, all direct non-virtual base classes and all non-static data members.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4050" mapped="yes"/>
                <message component="qacpp" id="4051" mapped="yes"/>
                <message component="qacpp" id="4052" mapped="yes"/>
                <message component="qacpp" id="4206" mapped="yes"/>
                <message component="qacpp" id="4207" mapped="yes"/>
                <message component="qacpp" id="4653" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-1-2.html">
              <text>Both NSDMI and a non-static member initializer in a constructor shall not be used in the same type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2326" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-1-3.html">
              <text>If all user-defined constructors of a class initialize data members with constant values that are the same across all constructors, then data members shall be initialized using NSDMI instead.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4656" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-1-4.html">
              <text>All constructors that are callable with a single argument of fundamental type shall be declared explicit.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2180" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-1-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-1-5.html">
              <text>Common class initialization for non-constant members shall be done by a delegating constructor.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4268" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-1-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-1-6.html">
              <text>Derived classes that do not need further explicit initialization and require all the constructors from the base class shall use inheriting constructors.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2541" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-4-1.html">
              <text>Destructor of a base class shall be public virtual, public override or protected non-virtual.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2116" mapped="no"/>
                <!-- struct IsArray final : std::false_type {} -->
                <message component="qacpp" id="2119" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-6-1.html">
              <text>All class data members that are initialized by the constructor shall be initialized using member initializers.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4051" mapped="yes"/>
                <message component="qacpp" id="4052" mapped="yes"/>
                <message component="qacpp" id="4054" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-7-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-7-1.html">
              <text>If the behavior of a user-defined special member function is identical to implicitly defined special member function, then it shall be defined "=default" or be left undefined.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2628" mapped="yes"/>
                <message component="qacpp" id="2634" mapped="yes"/>
                <message component="qacpp" id="2635" mapped="yes"/>
                <message component="qacpp" id="2636" mapped="yes"/>
                <message component="qacpp" id="2637" mapped="yes"/>
                <message component="qacpp" id="2649" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-8-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-1.html">
              <text>Move and copy constructors shall move and respectively copy base classes and data members of a class, without any side effects.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4285" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-8-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-3.html">
              <text>Moved-from object shall not be read-accessed.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4701" mapped="no"/>
                <!-- Definite: An object in an unspecified state is used. -->
                <message component="qacpp" id="4702" mapped="no"/>
                <!-- Apparent: An object in an unspecified state is used. -->
                <message component="qacpp" id="4703" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-8-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-4.html">
              <text>Move constructor shall not initialize its class members and base classes using copy semantics.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4654" mapped="yes"/>
                <message component="qacpp" id="4655" mapped="no"/>
                <!-- Member initialized using lvalue semantics in move constructor. -->
              </enforcement>
            </rule>
            <rule id="A12-8-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-5.html">
              <text>A copy assignment and a move assignment operators shall handle self-assignment.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4072" mapped="yes"/>
                <message component="qacpp" id="4073" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-8-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-6.html">
              <text>Copy and move constructors and copy assignment and move assignment operators shall be declared protected or defined "=delete" in base class.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2659" mapped="no"/>
                <!-- Base class '::ara::per::isoftkv::PConfigMuster' has non-deleted public copy/move special member functions. -->
              </enforcement>
            </rule>
            <rule id="A13-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-1-2.html">
              <text>User defined suffixes of the user defined literal operators shall start with underscore followed by one or more letters.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5218" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-1-3.html">
              <text>User defined literals operators shall only perform conversion of passed parameters.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4286" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-2-1.html">
              <text>An assignment operator shall return a reference to "this".</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2074" mapped="yes"/>
                <message component="qacpp" id="2093" mapped="yes"/>
                <message component="qacpp" id="4620" mapped="yes"/>
                <message component="qacpp" id="4621" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-2-2.html">
              <text>A binary arithmetic operator and a bitwise operator shall return a "prvalue".</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2072" mapped="no"/>
                <!-- Binary operator '::ara::per::ReadWriteAccessor &operator <<(::ara::core::internal::basic_string_view<char,::std::char_traits<char>>)' should not return a reference. -->
              </enforcement>
            </rule>
            <rule id="A13-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-2-3.html">
              <text>A relational operator shall return a boolean value.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2099" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-3-1.html">
              <text>A function that contains "forwarding reference" as its argument shall not be overloaded.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2023" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-5-1.html">
              <text>If "operator[]" is to be overloaded with a non-const version, const version shall also be implemented.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2140" mapped="yes"/>
                <message component="qacpp" id="2141" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-5-2.html">
              <text>All user-defined conversion operators shall be defined explicit.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2181" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-5-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-5-4.html">
              <text>If two opposite operators are defined, one shall be defined in terms of the other.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2095" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-5-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-5-5.html">
              <text>Comparison operators shall be non-member functions with identical parameter types and noexcept.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2066" mapped="yes"/>
                <message component="qacpp" id="2067" mapped="yes"/>
                <message component="qacpp" id="2068" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A13-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-6-1.html">
              <text>Digit sequences separators ' shall only be used as follows: (1) for decimal, every 3 digits, (2) for hexadecimal, every 2 digits, (3) for binary, every 4 digits.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4420" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A14-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-5-1.html">
              <text>A template constructor shall not participate in overload resolution for a single argument of the enclosing class type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2638" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A14-7-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-7-1.html">
              <text>A type used as a template argument shall provide all members that are used by the template.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A14-7-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-7-2.html">
              <text>Template specialization shall be declared in the same file (1) as the primary template (2) as a user-defined type, for which the specialization is declared.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1730" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A14-8-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-8-2.html">
              <text>Explicit specializations of function templates shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3843" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-2.html">
              <text>At least the basic guarantee for exception safety shall be provided for all operations. In addition, each function may offer either the strong guarantee or the nothrow guarantee</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-1-2.html">
              <text>An exception object shall not be a pointer.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3505" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-1-4.html">
              <text>If a function exits with an exception, then before a throw, the function shall place all objects/resources that the function constructed in valid states or it shall delete them.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4756" mapped="yes"/>
                <message component="qacpp" id="4757" mapped="yes"/>
                <message component="qacpp" id="4758" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-2-1.html">
              <text>Constructors that are not noexcept shall not be invoked before program startup.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4634" mapped="no"/>
                <!-- The code in the constructor for this non-local object with static storage duration may throw an exception. -->
              </enforcement>
            </rule>
            <rule id="A15-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-2-2.html">
              <text>If a constructor is not noexcept and the constructor cannot finish object initialization, then it shall deallocate the object's resources and it shall throw an exception.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-3-3.html">
              <text>Main function and a task main function shall catch at least: base class exceptions from all third-party libraries used, std::exception and all otherwise unhandled exceptions.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4037" mapped="yes"/>
                <message component="qacpp" id="4038" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-3-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-3-5.html">
              <text>A class type exception shall be caught by reference or const reference.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4031" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-4-1.html">
              <text>Dynamic exception-specification shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0095" mapped="yes"/>
                <message component="qacpp" id="2034" mapped="yes"/>
                <message component="qacpp" id="2035" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-4-2.html">
              <text>If a function is declared to be noexcept, noexcept(true) or noexcept(\textless true condition\textgreater), then it shall not exit with an exception.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4035" mapped="yes"/>
                <message component="qacpp" id="4036" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-4-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-4-3.html">
              <text>The noexcept specification of a function shall either be identical across all translation units, or identical or more restrictive between a virtual member function and an overrider.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0204" mapped="yes"/>
                <message component="qacpp" id="0229" mapped="yes"/>
                <message component="rcma" id="1510" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-4-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-4-4.html">
              <text>A declaration of non-throwing function shall contain noexcept specification.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2601" mapped="yes"/>
                <message component="qacpp" id="2602" mapped="no"/>
                <!-- This function's noexcept behavior should be explicitly specified using noexcept(<condition>) specifier. -->
                <message component="qacpp" id="2603" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-4-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-4-5.html">
              <text>Checked exceptions that could be thrown from a function shall be specified together with the function declaration and they shall be identical in all function declarations and for all its overriders.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-5-1.html">
              <text>All user-provided class destructors, deallocation functions,move constructors, move assignment operators and swap functions shall not exit with an exception.  A noexcept exception specification shall be added to these functions as appropriate.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2039" mapped="yes"/>
                <message component="qacpp" id="2044" mapped="yes"/>
                <message component="qacpp" id="2045" mapped="yes"/>
                <message component="qacpp" id="2046" mapped="yes"/>
                <message component="qacpp" id="2047" mapped="yes"/>
                <message component="qacpp" id="2048" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-5-2.html">
              <text>Program shall not be abruptly terminated. In particular, an implicit or explicit invocation of std::abort(), std::quick_exit(), std::_Exit(), std::terminate() shall not be done.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4633" mapped="yes"/>
                <message component="qacpp" id="4634" mapped="no"/>
                <!-- The code in the constructor for this non-local object with static storage duration may throw an exception. -->
                <message component="qacpp" id="4636" mapped="yes"/>
                <message component="qacpp" id="4637" mapped="yes"/>
                <message component="qacpp" id="4696" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-5-3.html">
              <text>The std::terminate() function shall not be called implicitly.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4037" mapped="yes"/>
                <message component="qacpp" id="4038" mapped="yes"/>
                <message component="qacpp" id="4633" mapped="yes"/>
                <message component="qacpp" id="4634" mapped="no"/>
                <!-- The code in the constructor for this non-local object with static storage duration may throw an exception. -->
                <message component="qacpp" id="4636" mapped="yes"/>
                <message component="qacpp" id="4637" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A16-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A16-0-1.html">
              <text>The pre-processor shall only be used for unconditional and conditional file inclusion and include guards, and using the following directives: (1) #ifndef, (2) #ifdef, (3) #if, (4) #if defined, (5) #elif, (6) #else, (7) #define, (8) #endif, (9) #include.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1073" mapped="yes"/>
                <message component="qacpp" id="1074" mapped="no"/>
                <message component="qacpp" id="1075" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A16-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A16-2-1.html">
              <text>The ', ", /*, //, \ characters shall not occur in a header file name or in #include directive.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1016" mapped="yes"/>
                <message component="qacpp" id="1017" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A16-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A16-2-2.html">
              <text>There shall be no unused include directives.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1060" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A16-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A16-6-1.html">
              <text>#error directive shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1073" mapped="yes"/>
                <message component="qacpp" id="1075" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A16-7-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A16-7-1.html">
              <text>The #pragma directive shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1040" mapped="no"/>
                <!-- This is a #pragma directive -->
              </enforcement>
            </rule>
            <rule id="A17-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A17-0-1.html">
              <text>Reserved identifiers, macros and functions in the C++ standard library shall not be defined, redefined or undefined.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5171" mapped="yes"/>
                <message component="ascm" id="5172" mapped="yes"/>
                <message component="ascm" id="5173" mapped="yes"/>
                <message component="ascm" id="5174" mapped="yes"/>
                <message component="ascm" id="5175" mapped="yes"/>
                <message component="ascm" id="5176" mapped="yes"/>
                <message component="ascm" id="5177" mapped="yes"/>
                <message component="ascm" id="5178" mapped="yes"/>
                <message component="ascm" id="5179" mapped="yes"/>
                <message component="ascm" id="5180" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A17-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A17-6-1.html">
              <text>Non-standard entities shall not be added to standard namespaces.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3180" mapped="yes"/>
                <message component="qacpp" id="3181" mapped="yes"/>
                <message component="qacpp" id="3182" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-0-1.html">
              <text>The C library facilities shall only be accessed through C++ library headers.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1014" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-0-2.html">
              <text>The error state of a conversion from string to a numeric value shall be checked.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5023" mapped="yes"/>
                <message component="qacpp" id="3161" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-0-3.html">
              <text>The library &lt;clocale> (locale.h) and the setlocale function shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5019" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-1-1.html">
              <text>C-style arrays shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2410" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-1-2.html">
              <text>The std::vector&lt;bool> specialization shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5009" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-1-3.html">
              <text>The std::auto_ptr type shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5210" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-1-4.html">
              <text>A pointer pointing to an element of an array of objects shall not be passed to a smart pointer of single object type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3848" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-1-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-1-6.html">
              <text>All std::hash specializations for user-defined types shall have a noexcept function call operator.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2600" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-1.html">
              <text>Functions malloc, calloc, realloc and free shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5211" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-2.html">
              <text>Non-placement new or delete expressions shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5217" mapped="no"/>
                <!-- This is a call to 'void *::operator new(unsigned long)'. -->
              </enforcement>
            </rule>
            <rule id="A18-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-3.html">
              <text>The form of the delete expression shall match the form of the new expression used to allocate the memory.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3330" mapped="yes"/>
                <message component="qacpp" id="3331" mapped="yes"/>
                <message component="rcma" id="1530" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-4.html">
              <text>If a project has sized or unsized version of operator "delete" globally defined, then both sized and unsized versions shall be defined.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2098" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-5.html">
              <text>Memory management functions shall ensure the following: (a) deterministic behavior resulting with the existence of worst-case execution time, (b) avoiding memory fragmentation, (c) avoid running out of memory, (d) avoiding mismatched allocations or deallocations, (e) no dependence on non-deterministic calls to kernel.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2706" mapped="yes"/>
                <message component="qacpp" id="2707" mapped="yes"/>
                <message component="qacpp" id="2708" mapped="yes"/>
                <message component="qacpp" id="2711" mapped="yes"/>
                <message component="qacpp" id="2712" mapped="yes"/>
                <message component="qacpp" id="2713" mapped="yes"/>
                <message component="qacpp" id="2716" mapped="yes"/>
                <message component="qacpp" id="2717" mapped="yes"/>
                <message component="qacpp" id="2718" mapped="yes"/>
                <message component="qacpp" id="2721" mapped="yes"/>
                <message component="qacpp" id="2722" mapped="yes"/>
                <message component="qacpp" id="2723" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-8.html">
              <text>Objects that do not outlive a function shall have automatic storage duration.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3516" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-9" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-9.html">
              <text>Custom implementations of dynamic memory allocation and deallocation functions shall meet the semantic requirements specified in the corresponding "Required behaviour" clause from the C++ Standard.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4736" mapped="yes"/>
                <message component="qacpp" id="4737" mapped="yes"/>
                <message component="qacpp" id="4738" mapped="yes"/>
                <message component="qacpp" id="4739" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-10" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-10.html">
              <text>Placement new shall be used only with properly aligned pointers to sufficient storage capacity.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3119" mapped="yes"/>
                <message component="qacpp" id="3128" mapped="yes"/>
                <message component="qacpp" id="3520" mapped="yes"/>
                <message component="qacpp" id="3521" mapped="yes"/>
                <message component="qacpp" id="3522" mapped="yes"/>
                <message component="qacpp" id="3523" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-5-11" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-11.html">
              <text>"operator new" and "operator delete" shall be defined together.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2160" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-9-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-9-1.html">
              <text>The std::bind shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5212" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-9-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-9-2.html">
              <text>Forwarding values to other functions shall be done via: (1) std::move if the value is an rvalue reference, (2) std::forward if the value is forwarding reference.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3845" mapped="yes"/>
                <message component="qacpp" id="3846" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-9-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-9-3.html">
              <text>The std::move shall not be used on objects declared const or const&amp;.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3847" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A18-9-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-9-4.html">
              <text>An argument to std::forward shall not be subsequently used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4701" mapped="no"/>
                <!-- Definite: An object in an unspecified state is used. -->
                <message component="qacpp" id="4702" mapped="no"/>
                <!-- Apparent: An object in an unspecified state is used. -->
                <message component="qacpp" id="4703" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A20-8-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-1.html">
              <text>An already-owned pointer value shall not be stored in an unrelated smart pointer.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4721" mapped="yes"/>
                <message component="qacpp" id="4722" mapped="yes"/>
                <message component="qacpp" id="4723" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A20-8-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-2.html">
              <text>A std::unique_ptr shall be used to represent exclusive ownership.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A20-8-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-3.html">
              <text>A std::shared_ptr shall be used to represent shared ownership.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A20-8-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-4.html">
              <text>A std::unique_ptr shall be used over std::shared_ptr if ownership sharing is not required.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A20-8-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-5.html">
              <text>std::make_unique shall be used to construct objects owned by std::unique_ptr.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3813" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A20-8-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-6.html">
              <text>std::make_shared shall be used to construct objects owned by std::shared_ptr.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3801" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A21-8-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A21-8-1.html">
              <text>Arguments to character-handling functions shall be representable as an unsigned char.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2796" mapped="yes"/>
                <message component="qacpp" id="2797" mapped="yes"/>
                <message component="qacpp" id="2798" mapped="yes"/>
