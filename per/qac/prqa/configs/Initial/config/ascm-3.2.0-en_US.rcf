              <text>The character sequence /* shall not be used within a C-style comment.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1053" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M2-10-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M2-10-1.html">
              <text>Different identifiers shall be typographically unambiguous.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1710" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M2-13-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M2-13-2.html">
