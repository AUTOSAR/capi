            </rule>
            <rule id="A23-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A23-0-1.html">
              <text>An iterator shall not be implicitly converted to const_iterator.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3078" mapped="yes"/>
                <message component="qacpp" id="3079" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A23-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A23-0-2.html">
              <text>Elements of a container shall only be accessed via valid references, iterators, and pointers.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4746" mapped="yes"/>
                <message component="qacpp" id="4747" mapped="yes"/>
                <message component="qacpp" id="4748" mapped="yes"/>
                <message component="qacpp" id="4749" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A25-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A25-1-1.html">
              <text>Non-static data members or captured values of predicate function objects that are state related to this object's identity shall not be copied.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A26-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A26-5-1.html">
              <text>Pseudorandom numbers shall not be generated using std::rand().</text>
