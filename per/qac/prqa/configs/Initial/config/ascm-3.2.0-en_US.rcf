            </rule>
            <rule id="M3-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M3-1-2.html">
              <text>Functions shall not be declared at block scope.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
