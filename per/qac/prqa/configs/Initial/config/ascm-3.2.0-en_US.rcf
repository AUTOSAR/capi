                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5022" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A26-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A26-5-2.html">
              <text>Random number engines shall not be default-initialized.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5041" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A27-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A27-0-3.html">
              <text>Alternate input and output operations on a file stream shall not be used without an intervening flush or positioning call.</text>
