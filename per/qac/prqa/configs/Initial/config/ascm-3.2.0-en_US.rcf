    <rule id="ASCM-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.2.html">
      <text>AUTOSAR Required</text>
      <enforcement>
        <rule id="ASCM-1_1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.2.CMSubGroup.1.html">
          <text>Automated</text>
          <enforcement>
            <rule id="A0-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-1-1.html">
              <text>A project shall not contain instances of non-volatile variables being given values that are not subsequently used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2980" mapped="yes"/>
                <message component="qacpp" id="2981" mapped="yes"/>
                <message component="qacpp" id="2982" mapped="yes"/>
                <message component="qacpp" id="2983" mapped="yes"/>
                <message component="qacpp" id="4208" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A0-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-1-2.html">
              <text>The value returned by a function having a non-void return type that is not an overloaded operator shall be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3802" mapped="yes"/>
                <message component="qacpp" id="3803" mapped="yes"/>
                <message component="qacpp" id="3804" mapped="no"/>
                <!-- The return value of this function performing side effects is not used. -->
              </enforcement>
            </rule>
            <rule id="A0-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-1-3.html">
              <text>Every function defined in an anonymous namespace, or static function with internal linkage, or private member function shall be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1724" mapped="no"/>
                <!-- Static function or private method '::ara::per::isoftkv::PManagerKvStore::Debug_PrintKvStore(,ni)::@unnamed0::()@=(_,ni,ui)' of a class shall be used. -->
              </enforcement>
            </rule>
            <rule id="A0-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-1-4.html">
              <text>There shall be no unused named parameters in non-virtual functions.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4327" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A0-1-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-1-5.html">
              <text>There shall be no unused named parameters in the set of parameters for a virtual function and all the functions that override it.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4331" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A0-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-4-2.html">
              <text>Type long double shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2441" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A0-4-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-4-4.html">
              <text>Range, domain and pole errors shall be checked when using math functions.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A1-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A1-1-1.html">
              <text>All code shall conform to ISO/IEC 14882:2014 - Programming Language C++ and shall not use deprecated features.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0010" mapped="yes"/>
                <message component="qacpp" id="0011" mapped="yes"/>
                <message component="qacpp" id="0012" mapped="yes"/>
                <message component="qacpp" id="0013" mapped="yes"/>
