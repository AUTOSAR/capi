            <rule id="M3-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M3-2-1.html">
              <text>All declarations of an object or function shall have compatible types.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0131" mapped="yes"/>
                <message component="rcma" id="1510" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M3-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M3-2-2.html">
              <text>The One Definition Rule shall not be violated.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1509" mapped="yes"/>
              </enforcement>
