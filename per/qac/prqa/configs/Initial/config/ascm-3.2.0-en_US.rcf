                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4711" mapped="yes"/>
                <message component="qacpp" id="4712" mapped="yes"/>
                <message component="qacpp" id="4713" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A27-0-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A27-0-4.html">
              <text>C-style strings shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4151" mapped="no"/>
                <!-- C style char pointer has been used. -->
              </enforcement>
            </rule>
            <rule id="M0-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M0-1-1.html">
              <text>A project shall not contain unreachable code.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2880" mapped="yes"/>
                <message component="qacpp" id="2881" mapped="yes"/>
              </enforcement>
            </rule>
