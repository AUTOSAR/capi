            <rule id="A2-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-3-1.html">
              <text>Only those characters specified in the C++ Language Standard basic source character set shall be used in the source code.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1095" mapped="no"/>
                <message component="qacpp" id="1096" mapped="no"/>
              </enforcement>
            </rule>
            <rule id="A2-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-5-1.html">
              <text>Trigraphs shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1092" mapped="yes"/>
                <message component="qacpp" id="1097" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-5-2.html">
              <text>Digraphs shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1093" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-7-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-7-1.html">
              <text>The character \ shall not occur as a last character of a C++ comment.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1054" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-7-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-7-3.html">
              <text>All declarations of "user-defined" types, static and non-static data members, functions and methods shall be preceded by documentation.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2024" mapped="yes"/>
                <message component="qacpp" id="2025" mapped="yes"/>
                <message component="qacpp" id="2026" mapped="yes"/>
                <message component="qacpp" id="2027" mapped="yes"/>
                <message component="qacpp" id="2028" mapped="no"/>
                <!-- The '@param' fields in the documentation comment for FileStorage(::ara::per::isoftkv::PconfigMusterFile const &) do not match the declared parameter list. -->
                <message component="qacpp" id="2029" mapped="yes"/>
                <!-- The documentation comment for 'unsigned int GetPageInitLen() const' is missing a 'return' field. -->
              </enforcement>
            </rule>
            <rule id="A2-8-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-8-1.html">
              <text>A header file name should reflect the logical entity for which it provides declarations.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5215" mapped="no"/>
                <!-- Class name does not match the filename it is defined in. -->
              </enforcement>
            </rule>
            <rule id="A2-10-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-10-1.html">
              <text>An identifier declared in an inner scope shall not hide an identifier declared in an outer scope.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2502" mapped="yes"/>
                <message component="qacpp" id="2503" mapped="yes"/>
                <message component="qacpp" id="2504" mapped="yes"/>
                <message component="qacpp" id="2505" mapped="yes"/>
                <message component="qacpp" id="2506" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-10-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-10-4.html">
              <text>The identifier name of a non-member object with static storage duration or static function shall not be reused within a namespace.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1723" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-10-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-10-6.html">
              <text>A class or enumeration name shall not be hidden by a variable, function or enumerator declaration in the same scope.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2501" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-11-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-11-1.html">
              <text>Volatile keyword shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5219" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-13-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-13-1.html">
              <text>Only those escape sequences that are defined in ISO/IEC 14882:2014 shall be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0077" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-13-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-13-2.html">
              <text>String literals with different encoding prefixes shall not be concatenated.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0635" mapped="yes"/>
                <message component="qacpp" id="0636" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-13-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-13-3.html">
              <text>Type wchar_t shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2440" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-13-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-13-4.html">
              <text>String literals shall not be assigned to non-constant pointers.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3063" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-13-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-13-6.html">
              <text>Universal character names shall be used only inside character or string literals.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1163" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-1-1.html">
              <text>It shall be possible to include any header file in multiple translation units without violating the One Definition Rule.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1067" mapped="yes"/>
                <message component="qacpp" id="1068" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-1-2.html">
              <text>Header files, that are defined locally in the project, shall have a file name extension of one of: ".h", ".hpp" or ".hxx".</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5056" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-1-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-1-4.html">
              <text>When an array with external linkage is declared, its size shall be stated explicitly.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2430" mapped="yes"/>
                <message component="qacpp" id="2431" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-1-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-1-5.html">
              <text>A function definition shall only be placed in a class definition if (1) the function is intended to be inlined (2) it is a member function template (3) it is a member function of a class template.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2014" mapped="yes"/>
                <!-- This qualified template member function is not declared inline. -->
              </enforcement>
            </rule>
            <rule id="A3-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-3-1.html">
              <text>Objects or functions with external linkage (including members of named namespaces) shall be declared in a header file.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2641" mapped="yes"/>
                <message component="qacpp" id="2642" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-3-2.html">
              <text>Static and thread-local objects shall be constant-initialized.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2310" mapped="no"/>
                <!-- This non-local object will be initialized at runtime. -->
                <message component="qacpp" id="2328" mapped="no"/>
                <!-- This block-scope object with static or thread storage duration will be initialized at runtime. -->
              </enforcement>
            </rule>
            <rule id="A3-9-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-9-1.html">
              <text>Fixed width integer types from &lt;cstdint>, indicating the size and signedness, shall be used in place of the basic numerical types.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2427" mapped="no"/>
                <!-- Direct use of fundamental type. ph_thread_lock.h : nai_mutex_t -->
                <message component="qacpp" id="2428" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A4-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A4-5-1.html">
              <text>Expressions with type enum or enum class shall not be used as operands to built-in and overloaded operators other than the subscript operator [ ], the assignment operator =, the equality operators == and !=, the unary &amp; operator, and the relational operators &lt;, &lt;=, >, >=.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3710" mapped="yes"/>
                <message component="qacpp" id="3720" mapped="yes"/>
                <message component="qacpp" id="3721" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A4-7-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A4-7-1.html">
              <text>An integer expression shall not lead to data loss.</text>
