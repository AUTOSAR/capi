              </enforcement>
            </rule>
            <rule id="M3-9-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M3-9-1.html">
              <text>The types used for an object, a function return type, or a function parameter shall be token-for-token identical in all declarations and re-declarations.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2664" mapped="yes"/>
                <message component="qacpp" id="2665" mapped="yes"/>
                <message component="qacpp" id="2666" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M3-9-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M3-9-3.html">
              <text>The underlying bit representations of floating-point values shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2406" mapped="yes"/>
                <message component="qacpp" id="2407" mapped="yes"/>
                <message component="qacpp" id="3017" mapped="yes"/>
                <message component="qacpp" id="3118" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M4-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M4-5-1.html">
              <text>Expressions with type bool shall not be used as operands to built-in operators other than the assignment operator =, the logical operators &amp;&amp;, ||, !, the equality operators == and !=, the unary &amp; operator, and the conditional operator.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3709" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M4-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M4-5-3.html">
              <text>Expressions with type (plain) char and wchar_t shall not be used as operands to built-in operators other than the assignment operator =, the equality operators == and !=, and the unary &amp; operator.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3711" mapped="yes"/>
                <message component="qacpp" id="3712" mapped="yes"/>
                <message component="qacpp" id="3713" mapped="yes"/>
                <message component="qacpp" id="3714" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M4-10-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M4-10-1.html">
              <text>NULL shall not be used as an integer value.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3122" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M4-10-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M4-10-2.html">
              <text>Literal zero (0) shall not be used as the null-pointer-constant.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3124" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-3.html">
              <text>A cvalue expression shall not be implicitly converted to a different underlying type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3130" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-4.html">
              <text>An implicit integral conversion shall not change the signedness of the underlying type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3139" mapped="yes"/>
                <message component="qacpp" id="3140" mapped="yes"/>
                <message component="qacpp" id="3143" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-5.html">
              <text>There shall be no implicit floating-integral conversions.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3011" mapped="yes"/>
                <message component="qacpp" id="3015" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-6.html">
              <text>An implicit integral or floating-point conversion shall not reduce the size of the underlying type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3010" mapped="yes"/>
                <message component="qacpp" id="3012" mapped="yes"/>
                <message component="qacpp" id="3014" mapped="yes"/>
                <message component="qacpp" id="3018" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-7.html">
              <text>There shall be no explicit floating-integral conversions of a cvalue expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3131" mapped="yes"/>
                <message component="qacpp" id="3132" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-8.html">
              <text>An explicit integral or floating-point conversion shall not increase the size of the underlying type of a cvalue expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3133" mapped="yes"/>
                <message component="qacpp" id="3134" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-9" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-9.html">
              <text>An explicit integral conversion shall not change the signedness of the underlying type of a cvalue expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3135" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-10" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-10.html">
              <text>If the bitwise operators ~ and &lt;&lt; are applied to an operand with an underlying type of unsigned char or unsigned short, the result shall be immediately cast to the underlying type of the operand.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3136" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-11" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-11.html">
              <text>The plain char type shall only be used for the storage and use of character values.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3137" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-12" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-12.html">
              <text>Signed char and unsigned char type shall only be used for the storage and use of numeric values.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3715" mapped="yes"/>
                <message component="qacpp" id="3716" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-14" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-14.html">
              <text>The first operand of a conditional-operator shall have type bool.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3144" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-15" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-15.html">
              <text>Array indexing shall be the only form of pointer arithmetic.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3705" mapped="no"/>
                <!-- This is using pointer arithmetic. -->
                <message component="qacpp" id="3706" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-16" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-16.html">
              <text>A pointer operand and any pointer resulting from pointer arithmetic using that operand shall both address elements of the same array.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2930" mapped="yes"/>
                <message component="qacpp" id="2931" mapped="yes"/>
                <message component="qacpp" id="2932" mapped="yes"/>
                <message component="qacpp" id="2933" mapped="yes"/>
                <message component="qacpp" id="2934" mapped="no"/>
                <!-- Possible: Computing an invalid pointer value. -->
              </enforcement>
            </rule>
            <rule id="M5-0-17" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-17.html">
              <text>Subtraction between pointers shall only be applied to pointers that address elements of the same array.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2668" mapped="yes"/>
                <message component="qacpp" id="2761" mapped="yes"/>
                <message component="qacpp" id="2762" mapped="yes"/>
                <message component="qacpp" id="2763" mapped="yes"/>
                <message component="qacpp" id="2766" mapped="yes"/>
                <message component="qacpp" id="2767" mapped="yes"/>
                <message component="qacpp" id="2768" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-18" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-18.html">
              <text>>, >=, &lt;, &lt;= shall not be applied to objects of pointer type, except where they point to the same array.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2669" mapped="yes"/>
                <message component="qacpp" id="2771" mapped="yes"/>
                <message component="qacpp" id="2772" mapped="yes"/>
                <message component="qacpp" id="2773" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-20" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-20.html">
              <text>Non-constant operands to a binary bitwise operator shall have the same underlying type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3138" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-21" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-21.html">
              <text>Bitwise operators shall only be applied to operands of unsigned underlying type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3003" mapped="yes"/>
                <message component="qacpp" id="3004" mapped="yes"/>
                <message component="qacpp" id="3006" mapped="yes"/>
                <message component="qacpp" id="3321" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-2.html">
              <text>A pointer to a virtual base class shall only be cast to a pointer to a derived class by means of dynamic_cast.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3095" mapped="yes"/>
                <message component="qacpp" id="3096" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-6.html">
              <text>A cast shall not convert a pointer to a function to any other pointer type, including a pointer to function type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3048" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-8.html">
              <text>An object with integer type or pointer to void type shall not be converted to an object with pointer type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3041" mapped="yes"/>
                <message component="qacpp" id="3043" mapped="yes"/>
                <message component="qacpp" id="3045" mapped="yes"/>
                <message component="qacpp" id="3047" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-9" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-9.html">
              <text>A cast shall not convert a pointer type to an integral type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3040" mapped="yes"/>
                <message component="qacpp" id="3042" mapped="yes"/>
                <message component="qacpp" id="3044" mapped="yes"/>
                <message component="qacpp" id="3046" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-10" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-10.html">
              <text>The increment (++) and decrement (-) operators shall not be mixed with other operators in an expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3360" mapped="yes"/>
                <message component="qacpp" id="3361" mapped="yes"/>
                <message component="qacpp" id="3362" mapped="yes"/>
                <message component="qacpp" id="3363" mapped="yes"/>
                <message component="qacpp" id="3364" mapped="yes"/>
                <message component="qacpp" id="3365" mapped="yes"/>
                <message component="qacpp" id="3366" mapped="yes"/>
                <message component="qacpp" id="3367" mapped="yes"/>
                <message component="qacpp" id="3368" mapped="yes"/>
                <message component="qacpp" id="3369" mapped="yes"/>
                <message component="qacpp" id="3370" mapped="yes"/>
                <message component="qacpp" id="3371" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-11" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-11.html">
              <text>The comma operator, &amp;&amp; operator and the ||operator shall not be overloaded.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2077" mapped="yes"/>
                <message component="qacpp" id="2078" mapped="yes"/>
                <message component="qacpp" id="2079" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-12" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-12.html">
              <text>An identifier with array type passed as a function argument shall not decay to a pointer.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3840" mapped="no"/>
                <!-- Array type is used as a pointer type argument in the function call. -->
              </enforcement>
            </rule>
            <rule id="M5-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-3-1.html">
              <text>Each operand of the ! operator, the logical &amp;&amp; or the logical ||operators shall have type bool.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3145" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-3-2.html">
              <text>The unary minus operator shall not be applied to an expression whose underlying type is unsigned.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3002" mapped="yes"/>
                <message component="qacpp" id="3005" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-3-3.html">
              <text>The unary &amp; operator shall not be overloaded.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2092" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-3-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-3-4.html">
              <text>Evaluation of the operand to the sizeof operator shall not contain side effects.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3240" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-8-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-8-1.html">
              <text>The right hand operand of a shift operator shall lie between zero and one less than the width in bits of the underlying type of the left hand operand.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2791" mapped="yes"/>
                <message component="qacpp" id="2792" mapped="yes"/>
                <message component="qacpp" id="2793" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-14-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-14-1.html">
              <text>The right hand operand of a logical &amp;&amp; or ||operator shall not contain side effects.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3230" mapped="yes"/>
                <message component="qacpp" id="3235" mapped="yes"/>
                <message component="qacpp" id="3236" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-18-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-18-1.html">
              <text>The comma operator shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3340" mapped="yes"/>
                <message component="qacpp" id="3341" mapped="yes"/>
                <message component="qacpp" id="3342" mapped="yes"/>
                <message component="qacpp" id="3344" mapped="yes"/>
                <message component="qacpp" id="3346" mapped="yes"/>
                <message component="qacpp" id="3348" mapped="yes"/>
                <message component="qacpp" id="3349" mapped="yes"/>
                <message component="qacpp" id="3352" mapped="yes"/>
                <message component="qacpp" id="3353" mapped="yes"/>
                <message component="qacpp" id="3354" mapped="yes"/>
                <message component="qacpp" id="3356" mapped="yes"/>
                <message component="qacpp" id="3358" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-19-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-19-1.html">
              <text>Evaluation of constant unsigned integer expressions shall not lead to wrap-around.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2910" mapped="yes"/>
                <message component="qacpp" id="2911" mapped="yes"/>
                <message component="qacpp" id="2912" mapped="yes"/>
                <message component="qacpp" id="2913" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-2-1.html">
              <text>Assignment operators shall not be used in sub-expressions.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3902" mapped="yes"/>
                <message component="qacpp" id="3903" mapped="yes"/>
                <message component="qacpp" id="3904" mapped="yes"/>
                <message component="qacpp" id="3905" mapped="yes"/>
                <message component="qacpp" id="4071" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-2-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-2-2.html">
              <text>Floating-point expressions shall not be directly or indirectly tested for equality or inequality.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3270" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-2-3.html">
              <text>Before preprocessing, a null statement shall only occur on a line by itself; it may be followed by a comment, provided that the first character following the null statement is a white-space character.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4500" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-3-1.html">
              <text>The statement forming the body of a switch, while, do ... while or for statement shall be a compound statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4062" mapped="yes"/>
                <message component="qacpp" id="4063" mapped="yes"/>
                <message component="qacpp" id="4064" mapped="yes"/>
                <message component="qacpp" id="4065" mapped="yes"/>
                <message component="qacpp" id="4066" mapped="yes"/>
                <message component="qacpp" id="4068" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-1.html">
              <text>An if ( condition ) construct shall be followed by a compound statement. The else keyword shall be followed by either a compound statement, or another if statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4060" mapped="yes"/>
                <message component="qacpp" id="4061" mapped="yes"/>
                <message component="qacpp" id="4068" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-2.html">
              <text>All if ... else if constructs shall be terminated with an else clause.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4070" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-3.html">
              <text>A switch statement shall be a well-formed switch statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4065" mapped="yes"/>
                <message component="qacpp" id="4614" mapped="yes"/>
                <message component="qacpp" id="4615" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-4.html">
              <text>A switch-label shall only be used when the most closely-enclosing compound statement is the body of a switch statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4013" mapped="yes"/>
                <message component="qacpp" id="4014" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-5.html">
              <text>An unconditional throw or break statement shall terminate every non-empty switchclause.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4011" mapped="yes"/>
                <message component="qacpp" id="4612" mapped="yes"/>
                <message component="qacpp" id="4616" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-6.html">
              <text>The final clause of a switch statement shall be the default-clause.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4010" mapped="yes"/>
                <message component="qacpp" id="4012" mapped="yes"/>
                <message component="qacpp" id="4611" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-4-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-4-7.html">
              <text>The condition of a switch statement shall not have bool type.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4015" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-5-2.html">
              <text>If loop-counter is not modified by or ++, then, within condition, the loop-counter shall only be used as an operand to &lt;=, &lt;, > or >=.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4294" mapped="yes"/>
                <message component="qacpp" id="4299" mapped="yes"/>
                <message component="qacpp" id="4680" mapped="no"/>
                <!-- While loop counter 'nScanKvPageID' of fundamental type not compared with relational operator. -->
                <message component="qacpp" id="4681" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-5-3.html">
              <text>The loop-counter shall not be modified within condition or statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4235" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-5-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-5-4.html">
              <text>The loop-counter shall be modified by one of: -, ++, -=n, or +=n; where n remains constant for the duration of the loop.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4295" mapped="yes"/>
                <message component="qacpp" id="4296" mapped="yes"/>
                <message component="qacpp" id="4297" mapped="yes"/>
                <message component="qacpp" id="4298" mapped="yes"/>
                <message component="qacpp" id="4682" mapped="no"/>
                <!-- While loop counter 'nNextPageID' of fundamental type modified not with ++, - -, += or -=. -->
                <message component="qacpp" id="4683" mapped="no"/>
                <!-- While loop counter 'nCopyLen' of fundamental type is incremented/decremented by non-constant value. -->
                <message component="qacpp" id="4684" mapped="yes"/>
                <message component="qacpp" id="4685" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-5-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-5-5.html">
              <text>A loop-control-variable other than the loop-counter shall not be modified within condition or expression.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4290" mapped="yes"/>
                <message component="qacpp" id="4292" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-5-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-5-6.html">
              <text>A loop-control-variable other than the loop-counter which is modified in statement shall have type bool.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4232" mapped="yes"/>
                <message component="qacpp" id="4243" mapped="yes"/>
                <message component="qacpp" id="4244" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-6-1.html">
              <text>Any label referenced by a goto statement shall be declared in the same block, or in a block enclosing the goto statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4002" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-6-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-6-2.html">
              <text>The goto statement shall jump to a label declared later in the same function body.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4001" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M6-6-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M6-6-3.html">
              <text>The continue statement shall only be used within a well-formed for loop.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4600" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-1-2.html">
              <text>A pointer or reference parameter in a function shall be declared as pointer to const or reference to const if the corresponding object is not modified.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4213" mapped="yes"/>
                <message component="qacpp" id="4673" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-3-1.html">
              <text>The global namespace shall only contain main, namespace declarations and extern "C" declarations.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2000" mapped="yes"/>
                <message component="qacpp" id="2300" mapped="yes"/>
                <message component="qacpp" id="2400" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-3-2.html">
              <text>The identifier main shall not be used for a function other than the global function main.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2040" mapped="yes"/>
                <message component="qacpp" id="2041" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-3-3.html">
              <text>There shall be no unnamed namespaces in header files.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2518" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-3-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-3-4.html">
              <text>Using-directives shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2519" mapped="yes"/>
                <message component="qacpp" id="2520" mapped="yes"/>
                <message component="qacpp" id="2522" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-3-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-3-6.html">
              <text>Using-directives and using-declarations (excluding class scope or function scope using-declarations) shall not be used in header files.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2521" mapped="yes"/>
                <message component="qacpp" id="2522" mapped="yes"/>
                <message component="qacpp" id="2523" mapped="yes"/>
                <message component="qacpp" id="2524" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-4-2.html">
              <text>Assembler instructions shall only be introduced using the asm declaration.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0014" mapped="yes"/>
                <message component="qacpp" id="0029" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-4-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-4-3.html">
              <text>Assembly language shall be encapsulated and isolated.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4501" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M8-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M8-0-1.html">
              <text>An init-declarator-list or a member-declarator-list shall consist of a single initdeclarator or member-declarator respectively.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4107" mapped="yes"/>
                <message component="qacpp" id="4108" mapped="yes"/>
                <message component="qacpp" id="4109" mapped="yes"/>
                <message component="qacpp" id="4110" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M8-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M8-3-1.html">
              <text>Parameters in an overriding virtual function shall either use the same default arguments as the function they override, or else shall not specify any default arguments.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2018" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M8-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M8-4-2.html">
              <text>The identifiers used for the parameters in a re-declaration of a function shall be identical to those in the declaration.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2017" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M8-4-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M8-4-4.html">
              <text>A function identifier shall either be used to call the function or it shall be preceded by &amp;.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3058" mapped="yes"/>
                <message component="qacpp" id="3059" mapped="yes"/>
                <message component="qacpp" id="3116" mapped="yes"/>
                <message component="qacpp" id="3117" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M8-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M8-5-2.html">
              <text>Braces shall be used to indicate and match the structure in the non-zero initialization of arrays and structures.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2412" mapped="yes"/>
                <message component="qacpp" id="2416" mapped="yes"/>
                <message component="qacpp" id="2417" mapped="yes"/>
                <message component="qacpp" id="2418" mapped="yes"/>
                <message component="qacpp" id="2420" mapped="yes"/>
                <message component="qacpp" id="2421" mapped="yes"/>
                <message component="qacpp" id="2445" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M9-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M9-3-1.html">
              <text>Const member functions shall not return non-const pointers or references to classdata.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4623" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M9-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M9-3-3.html">
              <text>If a member function can be made static then it shall be made static, otherwise if it can be made const then it shall be made const.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4211" mapped="no"/>
                <message component="qacpp" id="4212" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M9-6-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M9-6-4.html">
              <text>Named bit-fields with signed integer type shall have a length of more than one bit.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2302" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M10-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M10-1-2.html">
              <text>A base class shall only be declared virtual if it is used in a diamond hierarchy.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1703" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M10-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M10-1-3.html">
              <text>An accessible base class shall not be both virtual and non-virtual in the same hierarchy.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2151" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M10-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M10-3-3.html">
              <text>A virtual function shall only be overridden by a pure virtual function if it is itself declared as pure virtual.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2126" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M11-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M11-0-1.html">
              <text>Member data in non-POD class types shall be private.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2100" mapped="no"/>
                <!-- 'stStorageIns' is public. -->
                <message component="qacpp" id="2101" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M12-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M12-1-1.html">
              <text>An object's dynamic type shall not be used from the body of its constructor or destructor.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4260" mapped="yes"/>
                <message component="qacpp" id="4261" mapped="yes"/>
                <message component="qacpp" id="4273" mapped="yes"/>
                <message component="qacpp" id="4274" mapped="yes"/>
                <message component="qacpp" id="4275" mapped="yes"/>
                <message component="qacpp" id="4276" mapped="yes"/>
                <message component="qacpp" id="4277" mapped="yes"/>
                <message component="qacpp" id="4278" mapped="yes"/>
                <message component="qacpp" id="4279" mapped="yes"/>
                <message component="qacpp" id="4280" mapped="yes"/>
                <message component="qacpp" id="4281" mapped="yes"/>
                <message component="qacpp" id="4282" mapped="yes"/>
                <message component="qacpp" id="4690" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M14-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M14-5-3.html">
              <text>A copy assignment operator shall be declared when there is a template assignment operator with a parameter that is a generic parameter.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2639" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M14-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M14-6-1.html">
              <text>In a class template with a dependent base, any name that may be found in that dependent base shall be referred to using a qualified-id or this->.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0467" mapped="yes"/>
                <message component="qacpp" id="0468" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-0-3.html">
              <text>Control shall not be transferred into a try or catch block using a goto or a switch statement.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4647" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-1-1.html">
              <text>The assignment-expression of a throw statement shall not itself cause an exception to be thrown.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3501" mapped="yes"/>
                <message component="qacpp" id="3502" mapped="yes"/>
                <message component="qacpp" id="3503" mapped="yes"/>
                <message component="qacpp" id="3504" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-1-2.html">
              <text>NULL shall not be thrown explicitly.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3123" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-1-3.html">
              <text>An empty throw (throw;) shall only be used in the compound statement of a catch handler.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4635" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-3-1.html">
              <text>Exceptions shall be raised only after start-up and before termination.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4633" mapped="yes"/>
                <message component="qacpp" id="4634" mapped="no"/>
                <!-- The code in the constructor for this non-local object with static storage duration may throw an exception. -->
              </enforcement>
            </rule>
            <rule id="M15-3-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-3-3.html">
              <text>Handlers of a function-try-block implementation of a class constructor or destructor shall not reference non-static members from this class or its bases.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3510" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-3-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-3-4.html">
              <text>Each exception explicitly thrown in the code shall have a handler of a compatible type in all call paths that could lead to that point.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4035" mapped="yes"/>
                <message component="qacpp" id="4036" mapped="yes"/>
                <message component="qacpp" id="4037" mapped="yes"/>
                <message component="qacpp" id="4038" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-3-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-3-6.html">
              <text>Where multiple handlers are provided in a single try-catch statement or functiontry- block for a derived class and some or all of its bases, the handlers shall be ordered most-derived to base class.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4030" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M15-3-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M15-3-7.html">
              <text>Where multiple handlers are provided in a single try-catch statement or functiontry- block, any ellipsis (catch-all) handler shall occur last.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4034" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-0-1.html">
              <text>#include directives in a file shall only be preceded by other pre-processor directives or comments.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5026" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-0-2.html">
              <text>Macros shall only be #define'd or #undef'd in the global namespace.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0055" mapped="yes"/>
                <message component="qacpp" id="1034" mapped="yes"/>
                <message component="qacpp" id="1035" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-0-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-0-5.html">
              <text>Arguments to a function-like macro shall not contain tokens that look like preprocessing directives.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1072" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-0-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-0-6.html">
              <text>In the definition of a function-like macro, each instance of a parameter shall be enclosed in parentheses, unless it is used as the operand of # or ##.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1030" mapped="no"/>
              </enforcement>
            </rule>
            <rule id="M16-0-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-0-7.html">
              <text>Undefined macro identifiers shall not be used in #if or #elif pre-processor directives, except as operands to the defined operator.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1036" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-0-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-0-8.html">
              <text>If the # token appears as the first token on a line, then it shall be immediately followed by a pre-processing token.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0040" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-1-1.html">
              <text>The defined pre-processor operator shall only be used in one of the two standard forms.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0022" mapped="yes"/>
                <message component="qacpp" id="0611" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-1-2.html">
              <text>All #else, #elif and #endif pre-processor directives shall reside in the same file as the #if or #ifdef directive to which they are related.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0021" mapped="yes"/>
                <message component="qacpp" id="0052" mapped="yes"/>
                <message component="qacpp" id="0053" mapped="yes"/>
                <message component="qacpp" id="0054" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-2-3.html">
              <text>Include guards shall be provided.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1001" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-3-1.html">
              <text>There shall be at most one occurrence of the # or ## operators in a single macro definition.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1110" mapped="yes"/>
                <message component="qacpp" id="1111" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M17-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M17-0-2.html">
              <text>The names of standard library macros and objects shall not be reused.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5181" mapped="yes"/>
                <message component="ascm" id="5182" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M17-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M17-0-3.html">
              <text>The names of standard library functions shall not be overridden.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5183" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M17-0-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M17-0-5.html">
              <text>The setjmp macro and the longjmp function shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5020" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M18-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M18-0-3.html">
              <text>The library functions abort, exit, getenv and system from library &lt;cstdlib> shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5024" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M18-0-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M18-0-4.html">
              <text>The time handling functions of library &lt;ctime> shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5025" mapped="yes"/>
                <message component="ascm" id="5186" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M18-0-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M18-0-5.html">
              <text>The unbounded functions of library &lt;cstring> shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5029" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M18-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M18-2-1.html">
              <text>The macro offsetof shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5018" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M18-7-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M18-7-1.html">
              <text>The signal handling facilities of &lt;csignal> shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5123" mapped="yes"/>
                <message component="ascm" id="5187" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M19-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M19-3-1.html">
              <text>The error indicator errno shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3224" mapped="no"/>
                <!-- This is using errno. -->
              </enforcement>
            </rule>
            <rule id="M27-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M27-0-1.html">
              <text>The stream input/output library &lt;cstdio> shall not be used.</text>
              <categories>
                <category>ASCM Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5188" mapped="yes"/>
              </enforcement>
            </rule>
          </enforcement>
        </rule>
        <rule id="ASCM-1_2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.2.CMSubGroup.2.html">
          <text>Non-Automated</text>
          <enforcement>
            <rule id="M0-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M0-3-1.html">
              <text>Minimization of run-time failures shall be ensured by the use of at least one of: (a) static analysis tools/techniques; (b) dynamic analysis tools/techniques; (c) explicit coding of checks to handle run-time faults.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2776" mapped="yes"/>
                <message component="qacpp" id="2777" mapped="yes"/>
                <message component="qacpp" id="2778" mapped="yes"/>
                <message component="qacpp" id="2791" mapped="yes"/>
                <message component="qacpp" id="2792" mapped="yes"/>
                <message component="qacpp" id="2793" mapped="yes"/>
                <message component="qacpp" id="2800" mapped="yes"/>
                <message component="qacpp" id="2801" mapped="yes"/>
                <message component="qacpp" id="2802" mapped="yes"/>
                <message component="qacpp" id="2803" mapped="yes"/>
                <message component="qacpp" id="2810" mapped="yes"/>
                <message component="qacpp" id="2811" mapped="yes"/>
                <message component="qacpp" id="2812" mapped="yes"/>
                <message component="qacpp" id="2813" mapped="yes"/>
                <message component="qacpp" id="2820" mapped="yes"/>
                <message component="qacpp" id="2821" mapped="yes"/>
                <message component="qacpp" id="2822" mapped="yes"/>
                <message component="qacpp" id="2823" mapped="yes"/>
                <message component="qacpp" id="2831" mapped="yes"/>
                <message component="qacpp" id="2832" mapped="yes"/>
                <message component="qacpp" id="2833" mapped="yes"/>
                <message component="qacpp" id="2840" mapped="yes"/>
                <message component="qacpp" id="2841" mapped="yes"/>
                <message component="qacpp" id="2842" mapped="yes"/>
                <message component="qacpp" id="2843" mapped="yes"/>
                <message component="qacpp" id="2844" mapped="no"/>
                <!-- Possible: Dereference of an invalid pointer value. -->
                <message component="qacpp" id="2861" mapped="yes"/>
                <message component="qacpp" id="2862" mapped="yes"/>
                <message component="qacpp" id="2863" mapped="yes"/>
                <message component="qacpp" id="2961" mapped="no"/>
                <!-- for (std::unique_ptr<isoftkv::PFileOpt> &fileOpt : vecReddFileOpt_) Definite: Using value of uninitialized automatic object '::ara::per::ReadAccessor::@destructor()::@BLK1::@for::size'. -->
                <message component="qacpp" id="2962" mapped="yes"/>
                <message component="qacpp" id="2963" mapped="yes"/>
                <message component="qacpp" id="2971" mapped="yes"/>
                <message component="qacpp" id="2972" mapped="yes"/>
                <message component="qacpp" id="2973" mapped="yes"/>
                <message component="qacpp" id="4880" mapped="yes"/>
                <message component="qacpp" id="4881" mapped="yes"/>
                <message component="qacpp" id="4882" mapped="yes"/>
                <message component="qacpp" id="4883" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M0-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M0-3-2.html">
              <text>If a function generates error information, then that error information shall be tested.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4126" mapped="yes"/>
                <message component="qacpp" id="4127" mapped="no"/>
                <!-- This output parameter value is not subsequently checked. -->
              </enforcement>
            </rule>
            <rule id="M0-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M0-4-2.html">
              <text>Use of floating-point arithmetic shall be documented.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3708" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A0-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-4-1.html">
              <text>Floating-point implementation shall comply with IEEE 754 standard.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A1-1-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A1-1-2.html">
              <text>A warning level of the compilation process shall be set in compliance with project policies.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A1-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A1-2-1.html">
              <text>When using a compiler toolchain (including preprocessor, compiler itself, linker, C++ standard libraries) in safety-related software, the tool confidence level (TCL) shall be determined. In case of TCL2 or TCL3, the compiler shall undergo a "Qualification of a software tool", as per ISO 26262-8.11.4.6.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A1-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A1-4-1.html">
              <text>Code metrics and their valid boundaries shall be defined and code shall comply with defined boundaries of code metrics.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A2-7-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-7-2.html">
              <text>Sections of code shall not be "commented out".</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1051" mapped="yes"/>
                <message component="qacpp" id="1052" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-7-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-7-5.html">
              <text>Comments shall not document any actions or sources (e.g. tables, figures, paragraphs, etc.) that are outside of the file.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A3-8-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-8-1.html">
              <text>An object shall not be accessed outside of its lifetime.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3327" mapped="yes"/>
                <message component="qacpp" id="3339" mapped="yes"/>
                <message component="qacpp" id="4303" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-3-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-3-1.html">
              <text>Evaluation of the operand to the typeid operator shall not contain side effects.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3241" mapped="yes"/>
                <message component="qacpp" id="3247" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-14" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-14.html">
              <text>Interfaces shall be precisely and strongly typed.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A9-6-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A9-6-2.html">
              <text>Bit-fields shall be used only when interfacing to hardware or conforming to communication protocols.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A10-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-0-1.html">
              <text>Public inheritance shall be used to implement "is-a" relationship.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A10-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-0-2.html">
              <text>Membership or non-public inheritance shall be used to implement "has-a" relationship.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-1.html">
              <text>A function shall not exit with an exception if it is able to complete its task.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-3.html">
              <text>Exception safety guarantee of a called function shall be considered.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-4.html">
              <text>Unchecked exceptions shall be used to represent errors from which the caller cannot reasonably be expected to recover.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-5.html">
              <text>Checked exceptions shall be used to represent errors from which the caller can reasonably be expected to recover.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-6.html">
              <text>An analysis shall be performed to analyze the failure modes of exception handling. In particular, the following failure modes shall be analyzed: (a) worst time execution time not existing or cannot be determined, (b) stack not correctly unwound, (c) exception not thrown, other exception thrown, wrong catch activated, (d) memory not available while exception handling.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-8.html">
              <text>A worst-case execution time (WCET) analysis shall be performed to determine maximum execution time constraints of the software, covering in particular the exceptions processing.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-1-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-1-5.html">
              <text>Exceptions shall not be thrown across execution boundaries.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-3-2.html">
              <text>If a function throws an exception, it shall be handled when meaningful actions can be taken, otherwise it shall be propagated.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-3-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-3-4.html">
              <text>Catch-all (ellipsis and std::exception) handlers shall be used only in (a) main, (b) task main functions, (c) in functions that are supposed to isolate independent components and (d) when calling third-party code that uses exceptions not according to AUTOSAR C++14 guidelines.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A16-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A16-2-3.html">
              <text>An include directive shall be added explicitly for every symbol used in a file.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A17-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A17-1-1.html">
              <text>Use of the C Standard Library shall be encapsulated and isolated.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A18-5-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-6.html">
              <text>An analysis shall be performed to analyze the failure modes of dynamic memory management. In particular, the following failure modes shall be analyzed: (a) non-deterministic behavior resulting with nonexistence of worst-case execution time, (b) memory fragmentation, (c) running out of memory, (d) mismatched allocations and deallocations, (e) dependence on non-deterministic calls to kernel.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A18-5-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A18-5-7.html">
              <text>If non-realtime implementation of dynamic memory management functions is used in the project, then memory shall only be allocated and deallocated during non-realtime program phases.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A20-8-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A20-8-7.html">
              <text>A std::weak_ptr shall be used to represent temporary shared ownership.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A25-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A25-4-1.html">
              <text>Ordering predicates used with associative containers and STL sorting and related algorithms shall adhere to a strict weak ordering relation.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3293" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A27-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A27-0-1.html">
              <text>Inputs from independent components shall be validated.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="M0-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M0-4-1.html">
              <text>Use of scaled-integer or fixed-point arithmetic shall be documented.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="M1-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M1-0-2.html">
              <text>Multiple compilers shall only be used if they have a common, defined interface.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="M5-17-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-17-1.html">
              <text>The semantic equivalence between a binary operator and its assignment operator form shall be preserved.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4222" mapped="no"/>
                <!-- This binary operator is not implemented in terms of its assignment version. -->
              </enforcement>
            </rule>
            <rule id="M7-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-4-1.html">
              <text>All usage of assembler shall be documented.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="0029" mapped="yes"/>
                <message component="qacpp" id="0060" mapped="yes"/>
                <message component="qacpp" id="1100" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-5-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-5-1.html">
              <text>A function shall not return a reference or a pointer to an automatic variable (including parameters), defined within the function.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4026" mapped="yes"/>
                <message component="qacpp" id="4027" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M7-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M7-5-2.html">
              <text>The address of an object with automatic storage shall not be assigned to another object that may persist after the first object has ceased to exist.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2515" mapped="yes"/>
                <message component="qacpp" id="2516" mapped="yes"/>
                <message component="qacpp" id="2527" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M9-6-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M9-6-1.html">
              <text>When the absolute positioning of bits representing a bit-field is required, then the behaviour and packing of bit-fields shall be documented.</text>
              <categories>
                <category>ASCM Non Automated Required Rules</category>
              </categories>
              <enforcement/>
            </rule>
          </enforcement>
        </rule>
        <rule id="ASCM-1_3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.2.CMSubGroup.3.html">
          <text>Automated Not Statically Enforceable</text>
          <enforcement>
            <rule id="A0-4-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-4-3.html">
              <text>The implementations in the chosen compiler shall strictly comply with the C++14 Language Standard.</text>
              <categories>
                <category>ASCM Automated Not Statically Enforceable</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1156" mapped="yes"/>
                <message component="qacpp" id="1165" mapped="yes"/>
                <message component="qacpp" id="1172" mapped="yes"/>
                <message component="qacpp" id="1173" mapped="yes"/>
                <message component="qacpp" id="1174" mapped="yes"/>
                <message component="qacpp" id="1175" mapped="yes"/>
                <message component="qacpp" id="1176" mapped="yes"/>
                <message component="qacpp" id="1177" mapped="yes"/>
                <message component="qacpp" id="1178" mapped="yes"/>
                <message component="qacpp" id="1179" mapped="yes"/>
                <message component="qacpp" id="1180" mapped="yes"/>
                <message component="qacpp" id="1181" mapped="yes"/>
                <message component="qacpp" id="1182" mapped="yes"/>
                <message component="qacpp" id="1183" mapped="yes"/>
                <message component="qacpp" id="1184" mapped="yes"/>
                <message component="qacpp" id="1185" mapped="yes"/>
                <message component="qacpp" id="1186" mapped="yes"/>
                <message component="qacpp" id="1187" mapped="yes"/>
                <message component="qacpp" id="1188" mapped="yes"/>
                <message component="qacpp" id="1189" mapped="yes"/>
                <message component="qacpp" id="1190" mapped="yes"/>
                <message component="qacpp" id="1191" mapped="yes"/>
                <message component="qacpp" id="1192" mapped="yes"/>
                <message component="qacpp" id="1193" mapped="yes"/>
                <message component="qacpp" id="1194" mapped="yes"/>
                <message component="qacpp" id="1195" mapped="yes"/>
                <message component="qacpp" id="1196" mapped="no"/>
                <!-- Guaranteed copy elision is only supported from C++ 17. -->
                <message component="qacpp" id="1197" mapped="yes"/>
                <message component="qacpp" id="1198" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A1-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A1-1-3.html">
              <text>An optimization option that disregards strict standard compliance shall not be turned on in the chosen compiler.</text>
              <categories>
                <category>ASCM Automated Not Statically Enforceable</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A15-0-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-0-7.html">
              <text>Exception handling mechanism shall guarantee a deterministic worst-case time execution time.</text>
              <categories>
                <category>ASCM Automated Not Statically Enforceable</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A17-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A17-0-2.html">
              <text>All project's code including used libraries (including standard and user-defined libraries) and any third-party user code shall conform to the AUTOSAR C++14 Coding Guidelines.</text>
              <categories>
                <category>ASCM Automated Not Statically Enforceable</category>
              </categories>
              <enforcement/>
            </rule>
          </enforcement>
        </rule>
      </enforcement>
    </rule>
    <rule id="ASCM-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.3.html">
      <text>AUTOSAR Advisory</text>
      <enforcement>
        <rule id="ASCM-2_1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.3.CMSubGroup.1.html">
          <text>Automated</text>
          <enforcement>
            <rule id="A0-1-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A0-1-6.html">
              <text>There should be no unused type declarations.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1535" mapped="yes"/>
                <message component="rcma" id="1536" mapped="yes"/>
                <message component="rcma" id="1755" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M0-1-10" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M0-1-10.html">
              <text>Every defined function should be called at least once.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1503" mapped="no"/>
                <!-- The function '::ara::per::ResetPersistency(_)' is defined but is not used within this project. -->
              </enforcement>
            </rule>
            <rule id="A1-4-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A1-4-3.html">
              <text>All code should compile free of compiler warnings.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1800" mapped="yes"/>
                <message component="qacpp" id="2865" mapped="yes"/>
                <message component="qacpp" id="3150" mapped="yes"/>
                <message component="qacpp" id="3151" mapped="yes"/>
                <message component="qacpp" id="3152" mapped="yes"/>
                <message component="qacpp" id="3153" mapped="yes"/>
                <message component="qacpp" id="3154" mapped="yes"/>
                <message component="qacpp" id="3155" mapped="yes"/>
                <message component="qacpp" id="3242" mapped="yes"/>
                <message component="qacpp" id="3243" mapped="yes"/>
                <message component="qacpp" id="3244" mapped="yes"/>
                <message component="qacpp" id="3245" mapped="yes"/>
                <message component="qacpp" id="3334" mapped="yes"/>
                <message component="qacpp" id="3718" mapped="yes"/>
                <message component="qacpp" id="4007" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-10-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-10-5.html">
              <text>An identifier name of a function with static storage duration or a non-member object with external or internal linkage should not be reused.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="rcma" id="1722" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A2-13-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-13-5.html">
              <text>Hexadecimal constants should be upper case.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4422" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-1-3.html">
              <text>Implementation files, that are defined locally in the project, should have a file name extension of ".cpp".</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5054" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A3-1-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A3-1-6.html">
              <text>Trivial accessor and mutator functions should be inlined.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4120" mapped="yes"/>
                <message component="qacpp" id="4121" mapped="yes"/>
                <message component="qacpp" id="4123" mapped="yes"/>
                <message component="qacpp" id="4124" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-6" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-6.html">
              <text>Return type of a non-void return type lambda expression should be explicitly specified.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2442" mapped="yes"/>
                <message component="qacpp" id="2443" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-8" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-8.html">
              <text>Lambda expressions should not be defined inside another lambda expression.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3722" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A5-1-9" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-1-9.html">
              <text>Identical unnamed lambda expressions shall be replaced with a named function or a named lambda expression.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A5-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A5-2-1.html">
              <text>dynamic_cast should not be used.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3400" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-5-3.html">
              <text>Do statements should not be used.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4689" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A6-5-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A6-5-4.html">
              <text>For-init-statement and expression should not perform actions other than loop-counter initialization and modification.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4228" mapped="yes"/>
                <message component="qacpp" id="4229" mapped="yes"/>
                <message component="qacpp" id="4241" mapped="yes"/>
                <message component="qacpp" id="4242" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A8-4-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-4.html">
              <text>Multiple output values from a function should be returned as a struct or tuple.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A8-5-4" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-5-4.html">
              <text>If a class has a user-declared constructor that takes a parameter of type std::initializer_list, then it shall be the only constructor apart from special member function constructors.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2199" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A11-0-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A11-0-1.html">
              <text>A non-POD type should be defined as class.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2175" mapped="no"/>
                <!-- This struct is not a POD type. -->
              </enforcement>
            </rule>
            <rule id="A12-4-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-4-2.html">
              <text>If a public destructor of a class is non-virtual, then the class should be declared final.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2658" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A12-8-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-2.html">
              <text>User-defined copy and move assignment operators should use user-defined no-throw swap function.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="4075" mapped="yes"/>
                <message component="qacpp" id="4076" mapped="no"/>
                <!-- This move assignment operator is not implemented using 'move and swap'. -->
              </enforcement>
            </rule>
            <rule id="A12-8-7" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A12-8-7.html">
              <text>Assignment operators should be declared with the ref-qualifier &amp;.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2051" mapped="no"/>
                <!-- Assignment operator '%1s' does not have an explicit lvalue reference qualifier -->
              </enforcement>
            </rule>
            <rule id="A13-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A13-5-3.html">
              <text>User-defined conversion operators should not be used.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3050" mapped="yes"/>
                <message component="qacpp" id="3065" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A14-5-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-5-2.html">
              <text>Class members that are not dependent on template class parameters should be defined in a separate base class.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A14-5-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-5-3.html">
              <text>A non-member generic operator shall only be declared in a namespace that does not contain class (struct) type, enum type or union type declarations.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2087" mapped="yes"/>
                <message component="qacpp" id="3336" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-1-1.html">
              <text>Only instances of types derived from std::exception should be thrown.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3500" mapped="yes"/>
                <message component="qacpp" id="3506" mapped="yes"/>
                <message component="qacpp" id="3507" mapped="yes"/>
                <message component="qacpp" id="3515" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="A15-1-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A15-1-3.html">
              <text>All thrown exceptions should be unique.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A27-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A27-0-2.html">
              <text>A C-style string shall guarantee sufficient space for data and the null terminator.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="ascm" id="5216" mapped="yes"/>
                <message component="qacpp" id="2835" mapped="yes"/>
                <message component="qacpp" id="2836" mapped="yes"/>
                <message component="qacpp" id="2839" mapped="yes"/>
                <message component="qacpp" id="2845" mapped="yes"/>
                <message component="qacpp" id="2846" mapped="yes"/>
                <message component="qacpp" id="2847" mapped="yes"/>
                <message component="qacpp" id="2848" mapped="yes"/>
                <message component="qacpp" id="2849" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-0-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-0-2.html">
              <text>Limited dependence should be placed on C++ operator precedence rules in expressions.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3700" mapped="yes"/>
                <message component="qacpp" id="3702" mapped="yes"/>
                <message component="qacpp" id="3703" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M5-2-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M5-2-3.html">
              <text>Casts from a base class to a derived class should not be performed on polymorphic types.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="3070" mapped="yes"/>
                <message component="qacpp" id="3076" mapped="yes"/>
                <message component="qacpp" id="3077" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M10-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M10-1-1.html">
              <text>Classes should not be derived from virtual bases.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2650" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M10-2-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M10-2-1.html">
              <text>Allaccessible entity names within a multiple inheritance hierarchy should be unique.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="2150" mapped="yes"/>
                <message component="qacpp" id="2159" mapped="yes"/>
              </enforcement>
            </rule>
            <rule id="M16-3-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/M16-3-2.html">
              <text>The # and ## operators should not be used.</text>
              <categories>
                <category>ASCM Automated Advisory Rules</category>
              </categories>
              <enforcement>
                <message component="qacpp" id="1038" mapped="yes"/>
                <message component="qacpp" id="1039" mapped="no"/>
              </enforcement>
            </rule>
          </enforcement>
        </rule>
        <rule id="ASCM-2_2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/ascm.CMGroup.3.CMSubGroup.2.html">
          <text>Non-Automated</text>
          <enforcement>
            <rule id="A2-8-2" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A2-8-2.html">
              <text>An implementation file name should reflect the logical entity for which it provides definitions.</text>
              <categories>
                <category>ASCM Non Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A7-2-5" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A7-2-5.html">
              <text>Enumerations should be used to represent sets of related named constants.</text>
              <categories>
                <category>ASCM Non Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A8-4-3" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A8-4-3.html">
              <text>Common ways of passing parameters should be used.</text>
              <categories>
                <category>ASCM Non Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A10-4-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A10-4-1.html">
              <text>Hierarchies should be based on interface classes.</text>
              <categories>
                <category>ASCM Non Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
            <rule id="A14-1-1" active="yes" help="ascm-3.2.0-rule_help-en_US/rules/A14-1-1.html">
              <text>A template should check if a specific template argument is suitable for this template.</text>
              <categories>
                <category>ASCM Non Automated Advisory Rules</category>
              </categories>
              <enforcement/>
            </rule>
          </enforcement>
        </rule>
      </enforcement>
    </rule>
  </rulegroup>
</rcf>
