@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(ara-com)
find_dependency(ara-core-types)
find_dependency(isoft-manifestreader)
find_dependency(nai)
if(@ARA_ENABLE_FSH@)
find_dependency(isoft-ara-fsh)
else()
find_dependency(ara-com-fsh)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@EXPORT_NAME@-targets.cmake")

check_required_components(@EXPORT_NAME@)