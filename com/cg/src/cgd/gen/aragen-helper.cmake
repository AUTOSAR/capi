macro(aragen_helper_add_project)
    # Project information: Design
    if(NOT DEFINED ARA_GEN_EXECUTABLE_FQN)
        set(ARA_GEN_EXECUTABLE_FQN /ISOFT/PlatformComponents/com/cg/exe/cgd)
    endif()
    get_filename_component(ARA_GEN_EXECUTABLE ${ARA_GEN_EXECUTABLE_FQN} NAME)

    if(NOT DEFINED CMAKE_BUILD_TYPE OR ${CMAKE_BUILD_TYPE} STREQUAL "")
        set(CMAKE_BUILD_TYPE "Debug")
    endif()

    if(NOT DEFINED ARA_GEN_EXECUTABLE_VERSION)
        set(ARA_GEN_EXECUTABLE_VERSION 1.0.0) # from EXECUTABLE version field
    endif()

    # Define cmake project
    project(${ARA_GEN_EXECUTABLE} VERSION ${ARA_GEN_EXECUTABLE_VERSION} LANGUAGES CXX)

    # Import base cmake modules
    find_package(isoft-cmake-common REQUIRED)
    find_package(ara-arxmls REQUIRED)

    # Set arxml models path
    set(ARA_GEN_ARXMLS ${ARA_GEN_ARXMLS}) # arxmls

    # Setup build defines
    #  Dependent libraries
    set(ARA_GEN_ARA_LIBS ara::core)
    # Cyclic dependent libraries (currently only com/cm-bind/cm-gen-code has this item)
    set(ARA_GEN_ARA_LIBS_LOOP_REFERENCE ara_com)

    #set(ENABLE_SINGLE_PRCESS_MODE ON)

    # If the service interface has someip deployment enabled, enable the following setting
    set(USE_NSOMEIP2 ON)
    set(HAS_SOMEIP_BINDING ON)

    set(USE_CG ON)
    set(HAS_CG_BINDING ON)


    # Import depends ara libs
    find_package(ara-gen REQUIRED)
    find_package(ara-core REQUIRED)
    if(ARA_ENABLE_EXEC OR ARA_WITH_EXEC)
    set(ARA_GEN_ARA_LIBS ${ARA_GEN_ARA_LIBS} ara::exec::execution_client)
    find_package(ara-exec-execution-client REQUIRED)
    endif()

    if(NOT TARGET ara_com)
    find_package(ara-com REQUIRED)
    endif()
    if(ARA_ENABLE_COM_NSOMEIP)
    if(NOT TARGET ara_com_nsomeip)
    find_package(ara-com-nsomeip REQUIRED)
    endif()
    set(ARA_GEN_ARA_LIBS_LOOP_REFERENCE ${ARA_GEN_ARA_LIBS_LOOP_REFERENCE} ara_com_nsomeip)
    endif()
    if(ARA_ENABLE_COM_CG)
    if(NOT TARGET ara_com_cg)
    find_package(ara-com-cg REQUIRED)
    endif()
    set(ARA_GEN_ARA_LIBS_LOOP_REFERENCE ${ARA_GEN_ARA_LIBS_LOOP_REFERENCE} ara_com_cg)
    endif()

